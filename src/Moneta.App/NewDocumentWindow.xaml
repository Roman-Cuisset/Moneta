<Window x:Class="Moneta.App.NewDocumentWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Nouveau dossier financier" Width="490" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource {x:Type Window}}">
 <StackPanel Margin="24">
  <TextBlock Text="Nouveau dossier financier" FontSize="20" FontWeight="SemiBold"/>
  <TextBlock Text="Un dossier vierge, sans opérations de démonstration. Son emplacement sera choisi au premier enregistrement." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,18"/>
  <Label Content="_Nom du dossier" Target="{Binding ElementName=DocumentName}"/>
  <TextBox x:Name="DocumentName" MaxLength="120" AutomationProperties.AutomationId="DocumentName" AutomationProperties.Name="Nom du nouveau dossier financier"/>
  <TextBlock x:Name="ErrorText" Foreground="{DynamicResource NegativeBrush}" Margin="0,8,0,0"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="Annuler" IsCancel="True" MinWidth="90" Margin="0,0,8,0"/><Button Content="Créer" IsDefault="True" Click="Create_Click" MinWidth="90" AutomationProperties.AutomationId="CreateDocument"/></StackPanel>
 </StackPanel>
</Window>
