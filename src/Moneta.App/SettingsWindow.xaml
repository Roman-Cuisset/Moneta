<Window x:Class="Moneta.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Moneta.App"
        Title="{loc:LocalizedText SettingsWindow.OptionsMoneta}" Width="780" Height="560" MinWidth="700" MinHeight="460"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Style="{StaticResource {x:Type Window}}" Language="{loc:LocalizedLanguage}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="{loc:LocalizedText Common.Options}" Style="{StaticResource WindowHeading}" />
            <TextBlock Text="{loc:LocalizedText SettingsWindow.NonFinancialLocalPreferencesChangesAreOnlyApplied}"
                       TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" />
        </StackPanel>
        <TabControl Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                    Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}">
            <TabItem Header="{loc:LocalizedText SettingsWindow.GeneralAccessKey}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
                    <StackPanel>
                        <TextBlock Text="{loc:LocalizedText SettingsWindow.PreferencesOnThisComputer}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <TextBlock Text="{loc:LocalizedText SettingsWindow.TheThemeRateProviderAndStartOptionsAre}"
                                   TextWrapping="Wrap" Margin="0,0,0,14" />
                        <TextBlock Text="{loc:LocalizedText SettingsWindow.PreferenceFile}" Margin="0,0,0,5" />
                        <TextBox x:Name="SettingsPath" IsReadOnly="True" TextWrapping="Wrap"
                                 AutomationProperties.Name="{loc:LocalizedText SettingsWindow.PathOfThePreferenceFile}" />
                        <TextBlock x:Name="LoadWarning" TextWrapping="Wrap" Margin="0,14,0,0"
                                   Foreground="{DynamicResource NegativeBrush}" Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{loc:LocalizedText Settings.LanguageTab}">
                <StackPanel Margin="18">
                    <Label Content="{loc:LocalizedText Settings.LanguageTab}" Target="{Binding ElementName=LanguageChoice}" />
                    <ComboBox x:Name="LanguageChoice" HorizontalAlignment="Left" MinWidth="210"
                              AutomationProperties.AutomationId="ApplicationLanguage"
                              AutomationProperties.Name="{loc:LocalizedText Settings.Language}"
                              SelectionChanged="LanguageChoice_SelectionChanged">
                        <ComboBoxItem Content="Français" Tag="fr-FR" />
                        <ComboBoxItem Content="English" Tag="en-US" />
                    </ComboBox>
                    <TextBlock Text="{loc:LocalizedText Settings.LanguagePreview}" TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedBrush}" Margin="0,14,0,0" />
                </StackPanel>
            </TabItem>
            <TabItem Header="{loc:LocalizedText SettingsWindow.AppearanceAccessKey}">
                <StackPanel Margin="18">
                    <TextBlock Text="{loc:LocalizedText SettingsWindow.ImplementationTheme}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <Label Target="{Binding ElementName=ThemeChoice}" Content="{loc:LocalizedText Common.ThemeAccessKey}" Padding="0,0,0,5"
                           Foreground="{DynamicResource TextBrush}" />
                    <ComboBox x:Name="ThemeChoice" HorizontalAlignment="Left" MinWidth="210"
                              AutomationProperties.Name="{loc:LocalizedText SettingsWindow.ImplementationTheme}">
                        <ComboBoxItem Content="{loc:LocalizedText SettingsWindow.Light}" Tag="Light" />
                        <ComboBoxItem Content="{loc:LocalizedText SettingsWindow.Dark}" Tag="Dark" />
                    </ComboBox>
                    <TextBlock Text="{loc:LocalizedText SettingsWindow.TheHighContrastOfWindowsRemainsAPriority}"
                               TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,14,0,0" />
                </StackPanel>
            </TabItem>
            <TabItem Header="{loc:LocalizedText SettingsWindow.CurrenciesAndRatesAccessKey}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18"><StackPanel>
                    <TextBlock Text="{loc:LocalizedText SettingsWindow.UpdatedRates}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <CheckBox x:Name="RefreshRates" Content="{loc:LocalizedText SettingsWindow.AutomaticallyUpdateStartUpRatesAccessKey}"
                              AutomationProperties.AutomationId="AutomaticRatesSetting" />
                    <Label Content="{loc:LocalizedText Common.OfficialSourceAccessKey}" Target="{Binding ElementName=RateSourceChoice}" Margin="0,12,0,4" />
                    <ComboBox x:Name="RateSourceChoice" HorizontalAlignment="Left" MinWidth="300"
                              AutomationProperties.AutomationId="RateSourceSetting" AutomationProperties.Name="{loc:LocalizedText SettingsWindow.OfficialSupplierSelected}">
                        <ComboBoxItem Content="{loc:LocalizedText SettingsWindow.NbrbNationalBankOfBelarus}" Tag="NBRB" />
                        <ComboBoxItem Content="{loc:LocalizedText SettingsWindow.CbrCentralBankOfRussia}" Tag="CBR" />
                    </ComboBox>
                    <TextBlock Text="{loc:LocalizedText SettingsWindow.TheOptionAppliesToTheNextStartWithout}"
                               TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,10" />
                    <TextBlock x:Name="RatesInformation" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <TextBlock Text="{loc:LocalizedText SettingsWindow.ToolsExchangeRateAllowsYouToViewHistory}"
                               TextWrapping="Wrap" />
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="{loc:LocalizedText SettingsWindow.UpdatesAccessKey}">
                <StackPanel Margin="18">
                    <TextBlock Text="{loc:LocalizedText SettingsWindow.CheckForUpdates}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <CheckBox x:Name="CheckUpdates" Content="{loc:LocalizedText SettingsWindow.AutomaticallySearchForUpdatesOnStartupAccessKey}"
                              Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="{loc:LocalizedText SettingsWindow.TheCheckConsultsTheMonetaCatalogueYouConfirm}"
                               TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0" />
                </StackPanel>
            </TabItem>
            <TabItem Header="{loc:LocalizedText Common.BackupsAccessKey}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18"><StackPanel>
                    <CheckBox x:Name="AutomaticBackup" Content="{loc:LocalizedText SettingsWindow.EnableAutomaticBackupsAccessKey}" />
                    <CheckBox x:Name="BackupAfterSave" Content="{loc:LocalizedText SettingsWindow.AfterSuccessfulRecordingAccessKey}" Margin="0,8,0,0" />
                    <CheckBox x:Name="BackupDaily" Content="{loc:LocalizedText SettingsWindow.EveryDayTheDocumentIsOpenedAccessKey}" Margin="0,8,0,0" />
                    <WrapPanel Margin="0,8,0,0">
                        <StackPanel Margin="0,0,18,0">
                            <Label Content="{loc:LocalizedText SettingsWindow.MinimumIntervalAfterCtrlSMinutes}" Target="{Binding ElementName=BackupInterval}" />
                            <TextBox x:Name="BackupInterval" MaxLength="4" Width="78" HorizontalAlignment="Left"
                                     AutomationProperties.Name="{loc:LocalizedText SettingsWindow.MinimumIntervalAfterCtrlSInMinutes}" />
                        </StackPanel>
                        <StackPanel>
                            <Label Content="{loc:LocalizedText SettingsWindow.VersionsToKeepPerDocument}" Target="{Binding ElementName=BackupRetention}" />
                            <TextBox x:Name="BackupRetention" MaxLength="3" Width="78" HorizontalAlignment="Left"
                                     AutomationProperties.Name="{loc:LocalizedText SettingsWindow.NumberOfBackupVersionsToKeep}" />
                        </StackPanel>
                    </WrapPanel>
                    <Label Content="{loc:LocalizedText SettingsWindow.LocalDestinationEmptyForDefaultDocumentAccessKey}" Target="{Binding ElementName=BackupDestination}" Margin="0,8,0,0" />
                    <DockPanel>
                        <Button Content="{loc:LocalizedText SettingsWindow.BrowseAccessKey}" Click="BrowseBackups_Click" DockPanel.Dock="Right" Margin="6,0,0,0" />
                        <TextBox x:Name="BackupDestination" AutomationProperties.Name="{loc:LocalizedText SettingsWindow.LocalDirectoryOfBackups}" />
                    </DockPanel>
                    <TextBlock x:Name="BackupDefaultPath" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,10" />
                    <TextBlock Text="{loc:LocalizedText SettingsWindow.AnotherDiscAlsoProtectsAgainstABreakdownOf}"
                               TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock x:Name="BackupInformation" TextWrapping="Wrap" Margin="0,8,0,6" />
                    <Button x:Name="BackupHistory" Content="{loc:LocalizedText SettingsWindow.BackupHistoryAccessKey}" Click="BackupHistory_Click" HorizontalAlignment="Left" />
                    <TextBlock x:Name="BackupValidation" TextWrapping="Wrap" Foreground="{DynamicResource NegativeBrush}" Margin="0,6,0,0" />
                </StackPanel></ScrollViewer>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{loc:LocalizedText Common.SaveAccessKey}" MinWidth="120" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" Margin="0,0,10,0" AutomationProperties.AutomationId="SaveSettings" />
            <Button Content="{loc:LocalizedText SettingsWindow.CancelAccessKey}" MinWidth="110" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
