<Window xmlns:loc="clr-namespace:Moneta.App" x:Class="Moneta.App.ReconciliationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{loc:LocalizedText Common.BankReconciliation}" Width="1120" Height="780" MinWidth="840" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource {x:Type Window}}" AutomationProperties.AutomationId="ReconciliationWindow" Language="{loc:LocalizedLanguage}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock x:Name="AccountHeading" Style="{StaticResource WindowHeading}" AutomationProperties.AutomationId="ReconciliationAccount" />
            <TextBlock x:Name="ReconciliationNotice" Text="{loc:LocalizedText ReconciliationWindow.CtrlSRecordsValidatedOrReopenedReconciliationsAfter}"
                       TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" AutomationProperties.AutomationId="ReconciliationDraftNotice" />
        </StackPanel>
        <TabControl Grid.Row="1" x:Name="ReconciliationTabs" AutomationProperties.AutomationId="ReconciliationTabs">
            <TabItem x:Name="StatementTab" Header="{loc:LocalizedText ReconciliationWindow.NewSurvey}" AutomationProperties.AutomationId="ReconciliationStatementTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12">
                <Grid MinHeight="285" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" MinHeight="80" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0"><Label Content="{loc:LocalizedText ReconciliationWindow.DateOfSurveyMmDdYyyyAccessKey}" Target="{Binding ElementName=StatementDate}" /><TextBox x:Name="StatementDate" MaxLength="10" TextChanged="StatementDate_Changed" AutomationProperties.AutomationId="StatementDate" AutomationProperties.Name="{loc:LocalizedText ReconciliationWindow.BankStatementEndDateDayMonthYear}" /></StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0"><Label Content="{loc:LocalizedText ReconciliationWindow.NumberOptionalAccessKey}" Target="{Binding ElementName=StatementNumber}" /><TextBox x:Name="StatementNumber" MaxLength="120" AutomationProperties.AutomationId="StatementNumber" AutomationProperties.Name="{loc:LocalizedText ReconciliationWindow.RecordNumberOptional}" /></StackPanel>
                        <StackPanel Grid.Column="2"><Label Content="{loc:LocalizedText ReconciliationWindow.FinalBalanceSignedFromStatementAccessKey}" Target="{Binding ElementName=StatementClosingBalance}" /><TextBox x:Name="StatementClosingBalance" MaxLength="128" TextAlignment="Right" TextChanged="ClosingBalance_Changed" AutomationProperties.AutomationId="StatementClosingBalance" AutomationProperties.Name="{loc:LocalizedText ReconciliationWindow.FinalSignedBalanceIndicatedByTheBankIn}" /></StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="0,8,0,6">
                        <Label Content="{loc:LocalizedText ReconciliationWindow.OpeningBalanceUnchangeable}" Target="{Binding ElementName=StatementOpeningBalance}" />
                        <TextBox x:Name="StatementOpeningBalance" IsReadOnly="True" IsTabStop="False" AutomationProperties.AutomationId="StatementOpeningBalance" AutomationProperties.Name="{loc:LocalizedText ReconciliationWindow.OpeningBalanceOfReconciliationNotSubjectToChange}" />
                        <TextBlock Text="{loc:LocalizedText ReconciliationWindow.LastValidatedFinalBalanceStillActiveIfNot}"
                                   TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" AutomationProperties.AutomationId="ReconciliationOpeningNotice" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" x:Name="LegacyWarning" TextWrapping="Wrap" Foreground="{DynamicResource NegativeBrush}" Margin="0,0,0,8" AutomationProperties.AutomationId="ReconciliationLegacyWarning" />
                    <DataGrid Grid.Row="3" x:Name="ReconciliationCandidates" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow"
                              CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              PreviewKeyDown="Candidates_KeyDown" MouseDoubleClick="Candidates_DoubleClick" AutomationProperties.AutomationId="ReconciliationCandidates">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{loc:LocalizedText ReconciliationWindow.Choice}" Width="60"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <CheckBox IsChecked="{Binding Selected, Mode=OneWay}" Checked="CandidateCheck_Changed" Unchecked="CandidateCheck_Changed" HorizontalAlignment="Center" AutomationProperties.AutomationId="ReconciliationCandidateCheck" AutomationProperties.Name="{loc:LocalizedText ReconciliationWindow.IncludeThisTransactionInTheStatement}" />
                            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="{loc:LocalizedText Common.Date}" Binding="{Binding DateText}" Width="100" />
                            <DataGridTextColumn Header="{loc:LocalizedText Common.Description}" Binding="{Binding Original.Label}" Width="*" />
                            <DataGridTextColumn Header="{loc:LocalizedText Common.Payee}" Binding="{Binding Original.Payee.Name}" Width="150" />
                            <DataGridTextColumn Header="{loc:LocalizedText ReconciliationWindow.AmountSigned}" Binding="{Binding AmountText}" Width="140" />
                            <DataGridTextColumn Header="{loc:LocalizedText Common.State}" Binding="{Binding StatusText}" Width="65" />
                            <DataGridTextColumn Header="{loc:LocalizedText ReconciliationWindow.ClearedOn}" Binding="{Binding MarkedOnText}" Width="105" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel Grid.Row="4" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button x:Name="CandidatesPrevious" Content="{loc:LocalizedText ReconciliationWindow.Prev}" Click="CandidatesPrevious_Click" Margin="0,0,6,0" AutomationProperties.AutomationId="CandidatesPrevious" />
                            <Button x:Name="CandidatesNext" Content="{loc:LocalizedText ReconciliationWindow.Next}" Click="CandidatesNext_Click" AutomationProperties.AutomationId="CandidatesNext" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="CandidatePageText" VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.AutomationId="ReconciliationCandidatePage" />
                            <Button Content="{loc:LocalizedText ReconciliationWindow.EmptySelection}" Click="ClearSelection_Click" AutomationProperties.AutomationId="ClearReconciliationSelection" />
                            <Button Content="{loc:LocalizedText ReconciliationWindow.Update}" Click="RefreshCandidates_Click" Margin="6,0,0,0" AutomationProperties.AutomationId="RefreshReconciliationCandidates" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="HistoryTab" Header="{loc:LocalizedText ReconciliationWindow.BackgroundAndReopening}" AutomationProperties.AutomationId="ReconciliationHistoryTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12">
                <Grid MinHeight="480" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                    <Grid.RowDefinitions><RowDefinition Height="2*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="3*" /></Grid.RowDefinitions>
                    <DataGrid x:Name="ReconciliationHistory" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" CanUserDeleteRows="False"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True" SelectionChanged="History_SelectionChanged" AutomationProperties.AutomationId="ReconciliationHistory">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:LocalizedText ReconciliationWindow.DateNoted}" Binding="{Binding DateText}" Width="100" />
                            <DataGridTextColumn Header="{loc:LocalizedText ReconciliationWindow.Number}" Binding="{Binding Session.StatementNumber}" Width="100" />
                            <DataGridTextColumn Header="{loc:LocalizedText Common.State}" Binding="{Binding StateText}" Width="85" />
                            <DataGridTextColumn Header="{loc:LocalizedText ReconciliationWindow.Opening}" Binding="{Binding OpeningText}" Width="120" />
                            <DataGridTextColumn Header="{loc:LocalizedText ReconciliationWindow.Closure}" Binding="{Binding ClosingText}" Width="120" />
                            <DataGridTextColumn Header="{loc:LocalizedText ReconciliationWindow.Validation}" Binding="{Binding ValidatedText}" Width="150" />
                            <DataGridTextColumn Header="{loc:LocalizedText ReconciliationWindow.Reopening}" Binding="{Binding ReopenedText}" Width="150" />
                            <DataGridTextColumn Header="{loc:LocalizedText Common.Reason}" Binding="{Binding Session.ReopenReason}" Width="200" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel Grid.Row="1" Margin="0,8,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="HistoryPrevious" Content="{loc:LocalizedText ReconciliationWindow.Prev}" Click="HistoryPrevious_Click" Margin="0,0,6,0" AutomationProperties.AutomationId="HistoryPrevious" />
                            <Button x:Name="HistoryNext" Content="{loc:LocalizedText ReconciliationWindow.Next}" Click="HistoryNext_Click" AutomationProperties.AutomationId="HistoryNext" />
                        </StackPanel>
                        <TextBlock x:Name="HistoryPageText" VerticalAlignment="Center" AutomationProperties.AutomationId="ReconciliationHistoryPage" />
                    </DockPanel>
                    <DockPanel Grid.Row="2" Margin="0,10,0,10">
                        <Button DockPanel.Dock="Right" x:Name="ReopenReconciliation" Content="{loc:LocalizedText ReconciliationWindow.ReopenTheLastActiveStatement}" IsEnabled="False" Click="Reopen_Click" AutomationProperties.AutomationId="ReopenReconciliation" />
                        <TextBlock Text="{loc:LocalizedText ReconciliationWindow.HistoryRetainedSnapshotsBeforeValidationAndImmutableEvents}"
                                   TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,12,0" AutomationProperties.AutomationId="ReconciliationHistoryNotice" />
                    </DockPanel>
                    <TabControl Grid.Row="3" AutomationProperties.AutomationId="ReconciliationDetailsTabs">
                        <TabItem Header="{loc:LocalizedText ReconciliationWindow.FixedTransactions}" AutomationProperties.AutomationId="ReconciliationEntriesTab">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="100" /></Grid.RowDefinitions>
                                <DataGrid x:Name="ReconciliationEntries" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                                          SelectionChanged="Entry_SelectionChanged" EnableRowVirtualization="True" EnableColumnVirtualization="True" AutomationProperties.AutomationId="ReconciliationEntries">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{loc:LocalizedText Common.Date}" Binding="{Binding DateText}" Width="100" />
                                        <DataGridTextColumn Header="{loc:LocalizedText ReconciliationWindow.OriginalWording}" Binding="{Binding Original.Label}" Width="*" />
                                        <DataGridTextColumn Header="{loc:LocalizedText ReconciliationWindow.AmountSigned}" Binding="{Binding AmountText}" Width="140" />
                                        <DataGridTextColumn Header="{loc:LocalizedText ReconciliationWindow.StatusBeforeValidation}" Binding="{Binding StatusText}" Width="140" />
                                        <DataGridTextColumn Header="{loc:LocalizedText ReconciliationWindow.ClearedOn}" Binding="{Binding MarkedOnText}" Width="100" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBox Grid.Row="1" x:Name="EntrySnapshotText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="ReconciliationEntrySnapshot" AutomationProperties.Name="{loc:LocalizedText ReconciliationWindow.FullInstantTransactionBeforeValidation}" />
                            </Grid>
                        </TabItem>
                        <TabItem Header="{loc:LocalizedText ReconciliationWindow.Events}" AutomationProperties.AutomationId="ReconciliationEventsTab">
                            <DataGrid x:Name="ReconciliationEvents" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" AutomationProperties.AutomationId="ReconciliationEvents">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:LocalizedText ReconciliationWindow.DateTime}" Binding="{Binding OccurredText}" Width="170" />
                                    <DataGridTextColumn Header="{loc:LocalizedText ReconciliationWindow.Event}" Binding="{Binding KindText}" Width="130" />
                                    <DataGridTextColumn Header="{loc:LocalizedText Common.Reason}" Binding="{Binding Event.Reason}" Width="*" />
                                    <DataGridTextColumn Header="{loc:LocalizedText ReconciliationWindow.Identifier}" Binding="{Binding Event.Id}" Width="260" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="2">
            <Grid Margin="0,10,0,0">
                <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected, ElementName=StatementTab}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                </Style.Triggers></Style></Grid.Style>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="ReconciliationSelectedCount" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.AutomationId="ReconciliationSelectedCount" />
                <TextBlock Grid.Column="1" x:Name="ReconciliationSelectedNet" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.AutomationId="ReconciliationSelectedNet" />
                <TextBlock Grid.Column="2" x:Name="ReconciliationGap" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.AutomationId="ReconciliationGap" />
                <Button Grid.Column="3" x:Name="ValidateReconciliation" Content="{loc:LocalizedText Common.ValidateInDraft}" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="Validate_Click" AutomationProperties.AutomationId="ValidateReconciliation" AutomationProperties.Name="{loc:LocalizedText ReconciliationWindow.ValidateInDraftCtrlSToRecord}" />
            </Grid>
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{DynamicResource NegativeBrush}" Margin="0,7,0,0"
                       AutomationProperties.AutomationId="ReconciliationError" AutomationProperties.LiveSetting="Assertive" />
        </StackPanel>
        <Button Grid.Row="3" Content="{loc:LocalizedText ReconciliationWindow.CancelCloseWithoutChange}" IsCancel="True" HorizontalAlignment="Right" Margin="0,12,0,0" AutomationProperties.AutomationId="CancelReconciliation" />
    </Grid>
</Window>
