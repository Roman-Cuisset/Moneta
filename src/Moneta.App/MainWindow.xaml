<Window x:Class="Moneta.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Moneta.App"
        Title="Moneta" Width="1280" Height="800" MinWidth="900" MinHeight="500"
        WindowStartupLocation="CenterScreen" FontFamily="{DynamicResource AppFont}" FontSize="13"
        Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FocusManager.FocusedElement="{Binding ElementName=AccountsSelector}">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Close" Executed="Close_Executed" />
        <CommandBinding Command="{x:Static local:WindowCommands.About}" Executed="About_Executed" />
        <CommandBinding Command="{x:Static local:WindowCommands.Settings}" Executed="Settings_Executed" />
        <CommandBinding Command="{x:Static local:WindowCommands.AddAccount}" Executed="AddAccount_Executed" CanExecute="AddAccount_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.AccountProperties}" Executed="AccountProperties_Executed" CanExecute="ManageAccount_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.ArchiveAccount}" Executed="SetAccountArchived_Executed" CanExecute="ManageAccount_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.ReactivateAccount}" Executed="SetAccountArchived_Executed" CanExecute="ManageAccount_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.MoveAccount}" Executed="MoveAccount_Executed" CanExecute="ManageAccount_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.DeleteAccount}" Executed="DeleteAccount_Executed" CanExecute="ManageAccount_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.Theme}" Executed="Theme_Executed" />
        <CommandBinding Command="{x:Static local:WindowCommands.New}" Executed="New_Executed" CanExecute="Available_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.Open}" Executed="Open_Executed" CanExecute="Available_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.ImportBankPerfect}" Executed="ImportBankPerfect_Executed" CanExecute="Available_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.Save}" Executed="Save_Executed" CanExecute="Save_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.SaveAs}" Executed="SaveAs_Executed" CanExecute="Save_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.Backup}" Executed="Backup_Executed" CanExecute="Backup_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.BackupHistory}" Executed="BackupHistory_Executed" CanExecute="BackupHistory_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.Schedule}" Executed="Schedule_Executed" CanExecute="Schedule_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.Restore}" Executed="Restore_Executed" CanExecute="Available_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.Demo}" Executed="Demo_Executed" CanExecute="Available_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.Search}" Executed="Search_Executed" CanExecute="Search_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.SearchFilters}" Executed="Search_Executed" CanExecute="Search_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.ClearSearch}" Executed="ClearSearch_Executed" CanExecute="Search_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.FinancialUndo}" CanExecute="Unavailable_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.FinancialRedo}" CanExecute="Unavailable_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.NewTransaction}" Executed="NewTransaction_Executed" CanExecute="NewTransaction_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.EditTransaction}" Executed="EditTransaction_Executed" CanExecute="SelectedTransaction_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.DeleteTransaction}" Executed="DeleteTransaction_Executed" CanExecute="SelectedTransaction_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.RefreshRates}" Executed="RefreshRates_Executed" CanExecute="RefreshRates_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.ShowRates}" Executed="ShowRates_Executed" CanExecute="Available_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.HistoricalConverter}" Executed="HistoricalFx_Executed" CanExecute="Available_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.HistoricalFlow}" Executed="HistoricalFx_Executed" CanExecute="HistoricalFx_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.HistoricalBalance}" Executed="HistoricalFx_Executed" CanExecute="HistoricalFx_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.TogglePointing}" Executed="TogglePointing_Executed" CanExecute="Pointing_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.MarkTransactions}" Executed="Mark_Executed" CanExecute="Pointing_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.UnmarkTransactions}" Executed="Unmark_Executed" CanExecute="Pointing_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.MarkingDate}" Executed="MarkingDate_Executed" CanExecute="MarkingDate_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.ShowMarkingDates}" Executed="ShowMarkingDates_Executed" CanExecute="ShowMarkingDates_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.Reconcile}" Executed="Reconcile_Executed" CanExecute="Reconcile_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.ReleaseLegacyReconciliation}" Executed="ReleaseLegacy_Executed" CanExecute="ReleaseLegacy_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.NewTransfer}" Executed="NewTransfer_Executed" CanExecute="NewTransfer_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.OpenTransfer}" Executed="OpenTransfer_Executed" CanExecute="ReadTransfer_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.NavigateTransfer}" Executed="NavigateTransfer_Executed" CanExecute="ReadTransfer_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.DeleteTransfer}" Executed="DeleteTransfer_Executed" CanExecute="DeleteTransfer_CanExecute" />
    </Window.CommandBindings>
    <Window.Resources>
        <!-- Géométries originales Moneta : aucune ressource ni forme extraite de BankPerfect. -->
        <Geometry x:Key="AccountsIcon">M3,4 H21 V20 H3 Z M8,4 V20 M3,10 H21 M12,8 H17 M12,14 H17</Geometry>
        <Geometry x:Key="OpenIcon">M2,19 V6 H9 L12,9 H21 L18,19 Z M2,11 H19</Geometry>
        <Geometry x:Key="SaveIcon">M4,3 H17 L21,7 V21 H4 Z M8,3 V10 H16 V3 M8,21 V14 H17 V21</Geometry>
        <Geometry x:Key="UndoIcon">M8,5 L3,10 L8,15 M3,10 H14 C22,10 22,20 14,20</Geometry>
        <Geometry x:Key="RedoIcon">M16,5 L21,10 L16,15 M21,10 H10 C2,10 2,20 10,20</Geometry>
        <Geometry x:Key="LockIcon">M5,10 H19 V21 H5 Z M8,10 V7 C8,1 16,1 16,7 V10 M12,14 V17</Geometry>
        <Geometry x:Key="BudgetIcon">M4,3 H20 V21 H4 Z M8,7 H16 M8,12 H11 M14,12 H16 M8,17 H11 M14,17 H16</Geometry>
        <Geometry x:Key="TotalsIcon">M18,4 H6 L12,12 L6,20 H18</Geometry>
        <Geometry x:Key="ChartIcon">M3,3 V21 H22 M7,17 V11 H10 V17 M14,17 V6 H17 V17</Geometry>
        <Geometry x:Key="FilterIcon">M3,4 H21 L14,12 V19 L10,21 V12 Z</Geometry>
        <Geometry x:Key="ScheduleIcon">M4,5 H20 V21 H4 Z M4,10 H20 M8,2 V8 M16,2 V8 M8,14 H10 M14,14 H16 M8,18 H10</Geometry>
        <Geometry x:Key="TransferIcon">M3,7 H20 M16,3 L20,7 L16,11 M21,17 H4 M8,13 L4,17 L8,21</Geometry>
        <Style x:Key="ToolIcon" TargetType="Path">
            <Setter Property="Width" Value="20" /><Setter Property="Height" Value="20" />
            <Setter Property="Stretch" Value="Uniform" /><Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="StrokeStartLineCap" Value="Round" /><Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" /><Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="ToolLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" /><Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="11.5" /><Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SecondaryCellText" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EntryField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True" /><Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="7,5" /><Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
    </Window.Resources>
    <Grid Background="{DynamicResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="8,3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Menu KeyboardNavigation.TabNavigation="Once" VerticalAlignment="Center" AutomationProperties.AutomationId="MainMenu">
                    <MenuItem Header="_Fichier">
                        <MenuItem Header="_Nouveau dossier…" Command="{x:Static local:WindowCommands.New}" AutomationProperties.AutomationId="NewDocumentCommand" />
                        <MenuItem Header="_Ouvrir…" Command="{x:Static local:WindowCommands.Open}" AutomationProperties.AutomationId="OpenDocumentCommand" />
                        <MenuItem Header="_Enregistrer" Command="{x:Static local:WindowCommands.Save}" AutomationProperties.AutomationId="SaveDocumentCommand" />
                        <MenuItem Header="Enregistrer _sous…" Command="{x:Static local:WindowCommands.SaveAs}" AutomationProperties.AutomationId="SaveAsDocumentCommand" />
                        <Separator />
                        <MenuItem Header="_Sauvegarder le dossier…" Command="{x:Static local:WindowCommands.Backup}" AutomationProperties.AutomationId="BackupDocumentCommand" />
                        <MenuItem Header="_Restaurer une sauvegarde…" Command="{x:Static local:WindowCommands.Restore}" AutomationProperties.AutomationId="RestoreDocumentCommand" />
                        <MenuItem Header="_Sauvegardes">
                            <MenuItem Header="_Historique…" Command="{x:Static local:WindowCommands.BackupHistory}" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Mode _démonstration" Command="{x:Static local:WindowCommands.Demo}" ToolTip="Données fictives en mémoire, sans possibilité d’enregistrement financier." AutomationProperties.AutomationId="DemoDocumentCommand" />
                        <Separator />
                        <MenuItem Header="_Importer">
                            <MenuItem Header="_BankPerfect (.bp)…" Command="{x:Static local:WindowCommands.ImportBankPerfect}" AutomationProperties.AutomationId="ImportBankPerfectCommand" />
                            <MenuItem Header="CSV…" Style="{StaticResource UnavailableMenuItem}" />
                            <MenuItem Header="QIF…" InputGestureText="Ctrl+Alt+Q" Style="{StaticResource UnavailableMenuItem}" />
                        </MenuItem>
                        <MenuItem Header="E_xporter">
                            <MenuItem Header="CSV…" Style="{StaticResource UnavailableMenuItem}" />
                            <MenuItem Header="QIF…" Style="{StaticResource UnavailableMenuItem}" />
                            <MenuItem Header="HTML…" Style="{StaticResource UnavailableMenuItem}" />
                            <MenuItem Header="XML…" Style="{StaticResource UnavailableMenuItem}" />
                            <MenuItem Header="Tableur…" Style="{StaticResource UnavailableMenuItem}" />
                        </MenuItem>
                        <MenuItem Header="Imprimer un RIB…" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="Enregistrer sur disque externe…" Style="{StaticResource UnavailableMenuItem}" />
                        <Separator /><MenuItem Header="_Quitter" Command="ApplicationCommands.Close" />
                    </MenuItem>
                    <MenuItem Header="_Édition">
                        <MenuItem Header="_Copier" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="C_oller" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="Annuler une opération" Command="{x:Static local:WindowCommands.FinancialUndo}" InputGestureText="Ctrl+Z (futur)" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="Refaire une opération" Command="{x:Static local:WindowCommands.FinancialRedo}" InputGestureText="Ctrl+Y (futur)" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="_Rechercher" Command="{x:Static local:WindowCommands.Search}" CommandParameter="Focus" />
                    </MenuItem>
                    <MenuItem Header="_Affichage">
                        <MenuItem Header="_Thème" SubmenuOpened="ThemeMenu_Opened">
                            <MenuItem x:Name="LightThemeItem" Header="_Clair" IsCheckable="True" Command="{x:Static local:WindowCommands.Theme}" CommandParameter="Light" />
                            <MenuItem x:Name="DarkThemeItem" Header="_Sombre" IsCheckable="True" Command="{x:Static local:WindowCommands.Theme}" CommandParameter="Dark" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Affichage sur _2 lignes" InputGestureText="F4" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem x:Name="ShowMarkingDatesItem" Header="Dates de pointage" IsCheckable="True" IsChecked="{Binding ShowMarkingDates, Mode=OneWay}" Command="{x:Static local:WindowCommands.ShowMarkingDates}" InputGestureText="F11 (registre)" AutomationProperties.AutomationId="ShowMarkingDatesCommand" />
                        <MenuItem Header="Filtres avancés…" Command="{x:Static local:WindowCommands.SearchFilters}" />
                        <MenuItem Header="Effacer les filtres" Command="{x:Static local:WindowCommands.ClearSearch}" />
                        <MenuItem Header="Cacher les lignes inutiles" InputGestureText="Ctrl+H" Style="{StaticResource UnavailableMenuItem}" />
                    </MenuItem>
                    <MenuItem Header="_Comptes">
                        <MenuItem Header="_Nouveau fichier de comptes…" Command="{x:Static local:WindowCommands.New}" ToolTip="Même commande que Fichier → Nouveau dossier." />
                        <MenuItem Header="_Ajouter un compte…" Command="{x:Static local:WindowCommands.AddAccount}" AutomationProperties.AutomationId="AddAccountCommand" />
                        <MenuItem Header="_Propriétés du compte…" Command="{x:Static local:WindowCommands.AccountProperties}" AutomationProperties.AutomationId="AccountPropertiesCommand" />
                        <MenuItem Header="Archiver le compte…" Command="{x:Static local:WindowCommands.ArchiveAccount}" />
                        <MenuItem Header="Réactiver le compte…" Command="{x:Static local:WindowCommands.ReactivateAccount}" />
                        <MenuItem Header="Monter le compte" Command="{x:Static local:WindowCommands.MoveAccount}" CommandParameter="Up" />
                        <MenuItem Header="Descendre le compte" Command="{x:Static local:WindowCommands.MoveAccount}" CommandParameter="Down" />
                        <MenuItem Header="Supprimer le compte vierge…" Command="{x:Static local:WindowCommands.DeleteAccount}" />
                        <MenuItem Header="Registre de tous les comptes…" Command="{x:Static local:WindowCommands.SearchFilters}" CommandParameter="All" InputGestureText="" />
                        <MenuItem Header="Afficher les comptes archivés" IsCheckable="True" IsChecked="{Binding ShowArchivedAccounts, Mode=TwoWay}" />
                        <MenuItem Header="Mot de passe…" Style="{StaticResource UnavailableMenuItem}" /><Separator />
                        <MenuItem Header="_Catégories…" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="_Tiers…" InputGestureText="F5" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="Modes de paiement…" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="_Échéancier…" Command="{x:Static local:WindowCommands.Schedule}" /><Separator />
                        <MenuItem Header="Total des comptes…" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="Relevé multi-comptes…" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="Sauvegardes…" Style="{StaticResource UnavailableMenuItem}" />
                    </MenuItem>
                    <MenuItem Header="_Opérations">
                        <MenuItem Header="_Nouvelle opération…" Command="{x:Static local:WindowCommands.NewTransaction}" InputGestureText="Ctrl+Entrée (registre)" AutomationProperties.AutomationId="NewTransactionCommand" />
                        <MenuItem Header="_Modifier…" Command="{x:Static local:WindowCommands.EditTransaction}" InputGestureText="Maj+Entrée (registre)" AutomationProperties.AutomationId="EditTransactionCommand" />
                        <MenuItem Header="_Supprimer…" Command="{x:Static local:WindowCommands.DeleteTransaction}" InputGestureText="Suppr / Ctrl+Suppr (registre)" AutomationProperties.AutomationId="DeleteTransactionCommand" />
                        <Separator />
                        <MenuItem Header="_Pointer la sélection" Command="{x:Static local:WindowCommands.MarkTransactions}" AutomationProperties.AutomationId="MarkTransactionsCommand" />
                        <MenuItem Header="_Dépointer la sélection" Command="{x:Static local:WindowCommands.UnmarkTransactions}" InputGestureText="Maj+P (registre)" AutomationProperties.AutomationId="UnmarkTransactionsCommand" />
                        <MenuItem Header="_Rapprochement bancaire…" Command="{x:Static local:WindowCommands.Reconcile}" InputGestureText="Ctrl+Maj+R (registre)" AutomationProperties.AutomationId="ReconcileCommand" />
                        <MenuItem Header="Réexaminer un état rapproché hérité…" Command="{x:Static local:WindowCommands.ReleaseLegacyReconciliation}" ToolTip="Sans relevé lié : libération explicite avec motif et historique, pas un rapprochement bancaire attesté." AutomationProperties.AutomationId="ReleaseLegacyCommand" />
                        <Separator />
                        <MenuItem Header="Charger un tiers…" InputGestureText="F10" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="Date de pointage…" Command="{x:Static local:WindowCommands.MarkingDate}" InputGestureText="Ctrl+Maj+P (registre)" AutomationProperties.AutomationId="MarkingDateCommand" /><Separator />
                        <MenuItem Header="Saisie multiple…" InputGestureText="F2" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="Modifier un groupe…" InputGestureText="Ctrl+M" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="_Virement…" Command="{x:Static local:WindowCommands.NewTransfer}" InputGestureText="Ctrl+Maj+T (registre)" AutomationProperties.AutomationId="NewTransferCommand" />
                        <MenuItem Header="Ouvrir le virement lié…" Command="{x:Static local:WindowCommands.OpenTransfer}" AutomationProperties.AutomationId="OpenTransferCommand" />
                        <MenuItem Header="Valoriser l’opération enregistrée…" Command="{x:Static local:WindowCommands.HistoricalFlow}" />
                        <MenuItem Header="Autre côté du virement" Command="{x:Static local:WindowCommands.NavigateTransfer}" AutomationProperties.AutomationId="NavigateTransferCommand" />
                        <MenuItem Header="Supprimer le virement entier…" Command="{x:Static local:WindowCommands.DeleteTransfer}" AutomationProperties.AutomationId="DeleteTransferCommand" />
                        <MenuItem Header="Convertir une ligne en transfert…" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="_Ventiler l'opération…" InputGestureText="F6" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="Champs supplémentaires…" InputGestureText="F3" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="Ajouter à l'échéancier…" Style="{StaticResource UnavailableMenuItem}" />
                    </MenuItem>
                    <MenuItem Header="O_utils">
                        <MenuItem Header="_Options…" Command="{x:Static local:WindowCommands.Settings}" /><Separator />
                        <MenuItem Header="_Cours de change…" Command="{x:Static local:WindowCommands.ShowRates}" AutomationProperties.AutomationId="ShowRatesCommand" />
                        <MenuItem Header="Actualiser les cours officiels" Command="{x:Static local:WindowCommands.RefreshRates}" AutomationProperties.AutomationId="RefreshRatesCommand" />
                        <MenuItem Header="Convertisseur historique…" Command="{x:Static local:WindowCommands.HistoricalConverter}" />
                        <MenuItem Header="Valoriser le solde à date…" Command="{x:Static local:WindowCommands.HistoricalBalance}" />
                        <MenuItem Header="Budget mensuel…" InputGestureText="Ctrl+B" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="Budget annuel…" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="Graphiques…" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="Totaux par catégories…" InputGestureText="Ctrl+T" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="Totaux par tiers…" InputGestureText="Ctrl+Alt+T" Style="{StaticResource UnavailableMenuItem}" /><Separator />
                        <MenuItem Header="Calcul automatique des champs…" Style="{StaticResource UnavailableMenuItem}" ToolTip="Ancien Ctrl+F BankPerfect ; conflit documenté avec Rechercher, réservé par la mission 5." />
                        <MenuItem Header="Notes…" InputGestureText="Ctrl+Maj+N" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="_Conversions de devises…" InputGestureText="Ctrl+D" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="Inverser les monnaies…" Style="{StaticResource UnavailableMenuItem}" /><Separator />
                        <MenuItem Header="Simulateur de crédit…" InputGestureText="Ctrl+L" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="Calculatrice…" InputGestureText="Ctrl+Maj+C" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="Conversions numériques…" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="Vérifier une carte bancaire…" Style="{StaticResource UnavailableMenuItem}" />
                    </MenuItem>
                    <MenuItem Header="_Plugins"><MenuItem Header="Gérer les extensions…" Style="{StaticResource UnavailableMenuItem}" /></MenuItem>
                    <MenuItem Header="_Internet">
                        <MenuItem Header="Sauvegarder par courriel…" InputGestureText="F9" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="Sauvegarder en ligne…" InputGestureText="Maj+F9" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="Télécharger les cours des titres…" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="Mise à jour…" Style="{StaticResource UnavailableMenuItem}" />
                    </MenuItem>
                    <MenuItem Header="_?">
                        <MenuItem Header="Télécharger le manuel…" InputGestureText="Ctrl+F1" Style="{StaticResource UnavailableMenuItem}" /><Separator />
                        <MenuItem Header="À _propos de Moneta…" Command="{x:Static local:WindowCommands.About}" />
                    </MenuItem>
                </Menu>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
            <ToolBarTray IsLocked="True" Background="{DynamicResource SurfaceBrush}" Margin="8,1">
                <ToolBar Background="{DynamicResource SurfaceBrush}" BorderThickness="0" Padding="0" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ToolBarTray}}" AutomationProperties.Name="Accès rapides">
                    <StackPanel Margin="4,2,12,4" ToolBar.OverflowMode="Never">
                        <TextBlock x:Name="DocumentCaption" Text="Aucun dossier ouvert" Style="{StaticResource MutedText}" Margin="2,0,0,4" MaxWidth="218" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="DocumentCaption" />
                        <ComboBox x:Name="AccountsSelector" Width="218" ItemsSource="{Binding VisibleAccounts}" DisplayMemberPath="DisplayName"
                                  SelectedItem="{Binding SelectedAccount, Mode=OneWay}" SelectionChanged="AccountSelectionChanged" IsSynchronizedWithCurrentItem="False"
                                  AutomationProperties.AutomationId="AccountsSelector" AutomationProperties.Name="Compte affiché"
                                  ToolTip="Choisir un compte du dossier affiché.">
                            <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                            </Style></ComboBox.ItemContainerStyle>
                        </ComboBox>
                    </StackPanel>
                    <Button Command="{x:Static local:WindowCommands.AddAccount}" Style="{StaticResource ToolbarButton}" ToolTip="Ajouter un compte au dossier affiché." AutomationProperties.Name="Comptes"><StackPanel><Path Data="{StaticResource AccountsIcon}" Style="{StaticResource ToolIcon}" /><TextBlock Text="Comptes" Style="{StaticResource ToolLabel}" /></StackPanel></Button>
                    <Button Command="{x:Static local:WindowCommands.Open}" Style="{StaticResource ToolbarButton}" AutomationProperties.Name="Ouvrir"><StackPanel><Path Data="{StaticResource OpenIcon}" Style="{StaticResource ToolIcon}" /><TextBlock Text="Ouvrir" Style="{StaticResource ToolLabel}" /></StackPanel></Button>
                    <Button Command="{x:Static local:WindowCommands.Save}" Style="{StaticResource ToolbarButton}" AutomationProperties.Name="Enregistrer"><StackPanel><Path Data="{StaticResource SaveIcon}" Style="{StaticResource ToolIcon}" /><TextBlock Text="Enregistrer" Style="{StaticResource ToolLabel}" /></StackPanel></Button>
                    <Separator />
                    <Button Command="{x:Static local:WindowCommands.FinancialUndo}" Style="{StaticResource UnavailableButton}" AutomationProperties.Name="Annuler"><StackPanel><Path Data="{StaticResource UndoIcon}" Style="{StaticResource ToolIcon}" /><TextBlock Text="Annuler" Style="{StaticResource ToolLabel}" /></StackPanel></Button>
                    <Button Command="{x:Static local:WindowCommands.FinancialRedo}" Style="{StaticResource UnavailableButton}" AutomationProperties.Name="Refaire"><StackPanel><Path Data="{StaticResource RedoIcon}" Style="{StaticResource ToolIcon}" /><TextBlock Text="Refaire" Style="{StaticResource ToolLabel}" /></StackPanel></Button>
                    <Button Style="{StaticResource UnavailableButton}" AutomationProperties.Name="Verrouillage"><StackPanel><Path Data="{StaticResource LockIcon}" Style="{StaticResource ToolIcon}" /><TextBlock Text="Verrouiller" Style="{StaticResource ToolLabel}" /></StackPanel></Button>
                    <Separator />
                    <Button Style="{StaticResource UnavailableButton}" AutomationProperties.Name="Budget"><StackPanel><Path Data="{StaticResource BudgetIcon}" Style="{StaticResource ToolIcon}" /><TextBlock Text="Budget" Style="{StaticResource ToolLabel}" /></StackPanel></Button>
                    <Button Style="{StaticResource UnavailableButton}" AutomationProperties.Name="Totaux"><StackPanel><Path Data="{StaticResource TotalsIcon}" Style="{StaticResource ToolIcon}" /><TextBlock Text="Totaux" Style="{StaticResource ToolLabel}" /></StackPanel></Button>
                    <Button Style="{StaticResource UnavailableButton}" AutomationProperties.Name="Graphiques"><StackPanel><Path Data="{StaticResource ChartIcon}" Style="{StaticResource ToolIcon}" /><TextBlock Text="Graphiques" Style="{StaticResource ToolLabel}" /></StackPanel></Button>
                    <Button Style="{StaticResource ToolbarButton}" Command="{x:Static local:WindowCommands.SearchFilters}" AutomationProperties.Name="Filtres"><StackPanel><Path Data="{StaticResource FilterIcon}" Style="{StaticResource ToolIcon}" /><TextBlock Text="Filtres" Style="{StaticResource ToolLabel}" /></StackPanel></Button>
                    <Button Command="{x:Static local:WindowCommands.Schedule}" Style="{StaticResource ToolbarButton}" AutomationProperties.Name="Échéancier"><StackPanel><Path Data="{StaticResource ScheduleIcon}" Style="{StaticResource ToolIcon}" /><TextBlock Text="Échéancier" Style="{StaticResource ToolLabel}" /></StackPanel></Button>
                    <Button Command="{x:Static local:WindowCommands.NewTransfer}" Style="{StaticResource ToolbarButton}" AutomationProperties.Name="Virement" AutomationProperties.AutomationId="NewTransferButton" ToolTip="Virement lié dans le dossier : deux montants natifs exacts, frais séparés."><StackPanel><Path Data="{StaticResource TransferIcon}" Style="{StaticResource ToolIcon}" /><TextBlock Text="Virement" Style="{StaticResource ToolLabel}" /></StackPanel></Button>
                </ToolBar>
            </ToolBarTray>
        </Border>
        <Grid Grid.Row="2" Margin="12,12,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="AccountPanelColumn" Width="240" MinWidth="200" MaxWidth="340" />
                <ColumnDefinition Width="9" /><ColumnDefinition Width="*" MinWidth="500" />
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" Focusable="True" FocusVisualStyle="{StaticResource KeyboardFocus}" AutomationProperties.Name="Résumé du compte défilant">
                <Grid MinHeight="500" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" MinHeight="60" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Comptes" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ListBox x:Name="AccountList" ItemsSource="{Binding VisibleAccounts}" DisplayMemberPath="DisplayName"
                                 SelectedItem="{Binding SelectedAccount, Mode=OneWay}" SelectionChanged="AccountSelectionChanged"
                                 PreviewMouseRightButtonDown="AccountList_RightClick" MaxHeight="105"
                                 IsSynchronizedWithCurrentItem="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                 Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}"
                                 BorderBrush="{DynamicResource DividerBrush}" AutomationProperties.Name="Comptes du dossier"
                                 AutomationProperties.AutomationId="AccountList">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="4,2"/>
                                    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
                                    <Setter Property="ToolTip" Value="{Binding DisplayName}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Propriétés du compte…" Command="{x:Static local:WindowCommands.AccountProperties}" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="Archiver le compte…" Command="{x:Static local:WindowCommands.ArchiveAccount}" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="Réactiver le compte…" Command="{x:Static local:WindowCommands.ReactivateAccount}" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <Separator/>
                                    <MenuItem Header="Monter" Command="{x:Static local:WindowCommands.MoveAccount}" CommandParameter="Up" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="Descendre" Command="{x:Static local:WindowCommands.MoveAccount}" CommandParameter="Down" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="Supprimer le compte vierge…" Command="{x:Static local:WindowCommands.DeleteAccount}" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                        <CheckBox Content="Afficher les comptes archivés" IsChecked="{Binding ShowArchivedAccounts, Mode=TwoWay}"
                                  Margin="0,5,0,10" AutomationProperties.AutomationId="ShowArchivedAccounts"/>
                        <TextBlock Text="{Binding SelectedAccount.Name}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="Archivé · consultation" Foreground="{DynamicResource MutedBrush}">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding SelectedAccount.Account.IsArchived}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding SelectedAccount.CurrencyCode}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,5,0,18" />
                        <DockPanel Margin="0,0,0,9"><TextBlock Text="Solde pointé" /><TextBlock Text="{Binding SelectedPointedBalanceText}" FontWeight="SemiBold" TextAlignment="Right" TextWrapping="Wrap" ToolTip="Solde initial + opérations pointées ou rapprochées, dans la devise native." AutomationProperties.AutomationId="PointedBalance" /></DockPanel>
                        <DockPanel Margin="0,0,0,9"><TextBlock Text="Non pointé" /><TextBlock Text="{Binding SelectedUnmarkedAmountText}" Style="{StaticResource MutedText}" TextAlignment="Right" ToolTip="Somme signée des opérations non pointées, sans le solde initial." AutomationProperties.AutomationId="UnmarkedAmount" /></DockPanel>
                        <Button x:Name="ScheduleReminder" Margin="0,0,0,14" Content="Échéancier"
                                Command="{x:Static local:WindowCommands.Schedule}" AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock Text="Solde actuel" Style="{StaticResource MutedText}" />
                        <Grid Margin="0,4,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DisplayBalanceText}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.AutomationId="AccountBalance" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding DisplayCurrencies}" DisplayMemberPath="Code" SelectedItem="{Binding DisplayCurrency, Mode=TwoWay}" AutomationProperties.AutomationId="BalanceCurrencySelector" AutomationProperties.Name="Devise d'affichage du solde" ToolTip="Affichage seulement : ne modifie ni la devise native ni les opérations." />
                        </Grid>
                        <TextBlock Text="{Binding NativeBalanceDescription}" Style="{StaticResource MutedText}" TextWrapping="Wrap" AutomationProperties.AutomationId="NativeBalance" />
                        <TextBlock Text="{Binding DisplayRateDescription}" Style="{StaticResource MutedText}" Margin="0,0,0,12" TextWrapping="Wrap" AutomationProperties.AutomationId="BalanceRateDescription" />
                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,14" />
                        <TextBlock Text="OPÉRATION SÉLECTIONNÉE" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,8" />
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <TextBox x:Name="DetailsText" Text="{Binding SelectedRowDetails, Mode=OneWay}" IsReadOnly="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                 Background="{DynamicResource SurfaceBrush}" BorderThickness="0" Padding="0" FontSize="11.5"
                                 AutomationProperties.AutomationId="DetailsText" AutomationProperties.Name="Détail de l'opération sélectionnée" />
                        <TextBlock Text="Sélectionnez une ligne du registre pour consulter ses détails." IsHitTestVisible="False" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedRow}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock Text="Solde après l'opération" Style="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding SelectedRow.BalanceText, TargetNullValue='—'}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,12" />
                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,12" />
                        <TextBlock Text="Solde prévisionnel" FontWeight="SemiBold" /><TextBlock Text="Indisponible · échéancier non implémenté" Style="{StaticResource MutedText}" Margin="0,4,0,8" />
                        <TextBlock Text="Date de prévision" Style="{StaticResource MutedText}" />
                        <TextBox Text="Non définie" IsEnabled="False" Margin="0,4,0,0" AutomationProperties.Name="Date de prévision indisponible" />
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </Border>
            <GridSplitter Grid.Column="1" Width="9" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" KeyboardIncrement="10" DragIncrement="1"
                          Background="{DynamicResource CanvasBrush}" Focusable="True" ShowsPreview="True"
                          AutomationProperties.AutomationId="AccountPanelSplitter" AutomationProperties.Name="Largeur du panneau de compte"
                          ToolTip="Ajuster la largeur du panneau de compte ; flèches gauche/droite au clavier.">
                <GridSplitter.Template><ControlTemplate TargetType="GridSplitter"><Border x:Name="Grip" Background="{TemplateBinding Background}"><Border Width="1" Height="40" Background="{DynamicResource BorderBrush}" /></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource AccentSoftBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></GridSplitter.Template>
            </GridSplitter>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Margin="3,0,3,10">
                    <DockPanel>
                        <TextBlock Text="Registre des opérations" FontSize="17" FontWeight="SemiBold" />
                    </DockPanel>
                    <DockPanel Margin="0,5,0,0" LastChildFill="True">
                        <Button x:Name="SearchContext" DockPanel.Dock="Right" Content="Retour aux résultats" Click="ReturnToResults_Click" Margin="6,0,0,0" Visibility="Collapsed"/>
                        <Button DockPanel.Dock="Right" Content="Rechercher" Command="{x:Static local:WindowCommands.Search}" Margin="6,0,0,0"/>
                        <TextBox x:Name="QuickSearch" MaxLength="240" KeyDown="QuickSearch_KeyDown" AutomationProperties.Name="Recherche rapide dans le compte sélectionné"
                                 ToolTip="Rechercher dans les opérations enregistrées de ce compte." />
                    </DockPanel>
                    <TextBlock Text="{Binding LedgerErrorText}" Foreground="{DynamicResource NegativeBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="LedgerErrorText">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Margin" Value="0,6,0,0" /><Style.Triggers><DataTrigger Binding="{Binding LedgerErrorText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding LedgerErrorText}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <DataGrid x:Name="TransactionsGrid" Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=OneWay}"
                          SelectionChanged="TransactionSelectionChanged" MouseDoubleClick="Transaction_DoubleClick" PreviewMouseRightButtonDown="Register_PreviewRightClick" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" CanUserResizeColumns="True" CanUserReorderColumns="False"
                          SelectionMode="Extended" SelectionUnit="FullRow" IsSynchronizedWithCurrentItem="False" ClipboardCopyMode="None"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                          HeadersVisibility="Column" RowHeight="42" ColumnHeaderHeight="32" GridLinesVisibility="Horizontal"
                          AutomationProperties.AutomationId="TransactionsGrid" AutomationProperties.Name="Registre du compte sélectionné"
                          AutomationProperties.HelpText="Ctrl ou Maj pour sélectionner plusieurs lignes de cette page. P / Espace : basculer non pointé / pointé ; Maj+P : dépointer ; Ctrl+Maj+R : rapprochement ; F11 : dates de pointage. Ctrl+S enregistre les brouillons.">
                    <DataGrid.InputBindings>
                        <KeyBinding Key="Enter" Modifiers="Control" Command="{x:Static local:WindowCommands.NewTransaction}" />
                        <KeyBinding Key="Enter" Modifiers="Shift" Command="{x:Static local:WindowCommands.EditTransaction}" />
                        <KeyBinding Key="Delete" Command="{x:Static local:WindowCommands.DeleteTransaction}" />
                        <KeyBinding Key="Delete" Modifiers="Control" Command="{x:Static local:WindowCommands.DeleteTransaction}" />
                        <KeyBinding Key="P" Command="{x:Static local:WindowCommands.TogglePointing}" />
                        <KeyBinding Key="Space" Command="{x:Static local:WindowCommands.TogglePointing}" />
                        <KeyBinding Key="P" Modifiers="Shift" Command="{x:Static local:WindowCommands.UnmarkTransactions}" />
                        <KeyBinding Key="P" Modifiers="Control+Shift" Command="{x:Static local:WindowCommands.MarkingDate}" />
                        <KeyBinding Key="R" Modifiers="Control+Shift" Command="{x:Static local:WindowCommands.Reconcile}" />
                        <KeyBinding Key="F11" Command="{x:Static local:WindowCommands.ShowMarkingDates}" />
                        <KeyBinding Key="T" Modifiers="Control+Shift" Command="{x:Static local:WindowCommands.NewTransfer}" />
                    </DataGrid.InputBindings>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Ouvrir le virement lié…" Command="{x:Static local:WindowCommands.OpenTransfer}" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="Autre côté du virement" Command="{x:Static local:WindowCommands.NavigateTransfer}" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="Supprimer le virement entier…" Command="{x:Static local:WindowCommands.DeleteTransfer}" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <Separator />
                            <MenuItem Header="Pointer la sélection" Command="{x:Static local:WindowCommands.MarkTransactions}" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="Dépointer la sélection" Command="{x:Static local:WindowCommands.UnmarkTransactions}" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="Date de pointage…" Command="{x:Static local:WindowCommands.MarkingDate}" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <Separator />
                            <MenuItem Header="Rapprochement bancaire…" Command="{x:Static local:WindowCommands.Reconcile}" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="Réexaminer un état rapproché hérité…" Command="{x:Static local:WindowCommands.ReleaseLegacyReconciliation}" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="RegisterDateColumn" Header="Date" Binding="{Binding DisplayDateText}" Width="102" MinWidth="90" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="Mode" Binding="{Binding PaymentModeName}" Width="112" MinWidth="95" ElementStyle="{StaticResource CellText}" />
                        <DataGridTemplateColumn Header="Tiers / libellé" Width="2*" MinWidth="170">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center" Margin="9,3">
                                <TextBlock Text="{Binding PayeeName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PayeeName}">
                                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><DataTrigger Binding="{Binding IsTransfer}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                <DockPanel>
                                    <DockPanel.Style><Style TargetType="DockPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsTransfer}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></DockPanel.Style>
                                    <Button Content="↔" Command="{x:Static local:WindowCommands.NavigateTransfer}" CommandParameter="{Binding}" CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}}" DockPanel.Dock="Right"
                                            Focusable="False" IsTabStop="False" Padding="3,0" MinHeight="18" Height="18" Margin="4,0,0,0" AutomationProperties.AutomationId="NavigateTransferCell" AutomationProperties.Name="Autre côté du virement" ToolTip="Afficher l’autre compte et sélectionner le mouvement lié." />
                                    <Button Content="{Binding TransferText}" Command="{x:Static local:WindowCommands.OpenTransfer}" CommandParameter="{Binding}" CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            HorizontalAlignment="Left" Focusable="False" IsTabStop="False" Padding="0" MinHeight="18" Height="18" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource AccentBrush}"
                                            AutomationProperties.AutomationId="OpenTransferCell" AutomationProperties.Name="Ouvrir le virement lié" ToolTip="Consulter ou modifier le virement entier, jamais une jambe isolée." />
                                </DockPanel>
                                <TextBlock Text="{Binding Label}" Style="{StaticResource SecondaryCellText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" />
                            </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Catégorie" Width="*" MinWidth="135">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center" Margin="9,3">
                                <TextBlock Text="{Binding CategoryName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CategoryName}" />
                                <TextBlock Text="{Binding SubcategoryName}" Style="{StaticResource SecondaryCellText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding SubcategoryName}" />
                            </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Débit" Binding="{Binding DebitText}" Width="112" MinWidth="100" ElementStyle="{StaticResource AmountText}" />
                        <DataGridTextColumn Header="Crédit" Binding="{Binding CreditText}" Width="112" MinWidth="100" ElementStyle="{StaticResource AmountText}" />
                        <DataGridTemplateColumn Header="Pointage" Width="150" MinWidth="115">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <Button Content="{Binding MarkText}" Command="{x:Static local:WindowCommands.TogglePointing}" CommandParameter="{Binding}"
                                        CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        Focusable="False" IsTabStop="False" Padding="5,3" Margin="4,1" MinHeight="26"
                                        ToolTip="Clic : non pointé ↔ pointé. Une opération rapprochée exige une réouverture explicite du relevé."
                                        ToolTipService.ShowOnDisabled="True" AutomationProperties.AutomationId="PointingCell" AutomationProperties.Name="{Binding MarkText}" />
                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" Padding="12,8" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Rows.Count}" Value="0" /><Condition Binding="{Binding LedgerErrorText}" Value="" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></Border.Style>
                    <TextBlock Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Aucune opération sur ce compte. Utilisez Nouvelle pour commencer." /><Style.Triggers><DataTrigger Binding="{Binding IsDemo}" Value="True"><Setter Property="Text" Value="Aucune opération fictive sur ce compte." /></DataTrigger><DataTrigger Binding="{Binding SelectedAccount}" Value="{x:Null}"><Setter Property="Text" Value="Ajoutez d’abord un compte depuis le menu Comptes." /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </Border>
                <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="6" Margin="0,8,0,0" Padding="10,7">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="False">
                        <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="‹" Width="30" Click="PreviousPage_Click" IsEnabled="{Binding CanPreviousPage}" AutomationProperties.AutomationId="PreviousLedgerPage" AutomationProperties.Name="Page précédente" />
                                <TextBlock Text="{Binding PageStatusText}" VerticalAlignment="Center" Margin="8,0" Foreground="{DynamicResource MutedBrush}" />
                                <Button Content="›" Width="30" Click="NextPage_Click" IsEnabled="{Binding CanNextPage}" AutomationProperties.AutomationId="NextLedgerPage" AutomationProperties.Name="Page suivante" />
                            </StackPanel>
                            <TextBlock Text="Brouillon → Enregistrer (Ctrl+S)" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                        </DockPanel>
                        <Grid MinWidth="715">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="100" /><ColumnDefinition Width="*" MinWidth="105" /><ColumnDefinition Width="*" MinWidth="105" /><ColumnDefinition Width="125" /><ColumnDefinition Width="175" /></Grid.ColumnDefinitions>
                            <Grid.Resources><Style TargetType="StackPanel"><Setter Property="Margin" Value="0,0,8,0" /></Style></Grid.Resources>
                            <StackPanel><TextBlock Text="Date" Style="{StaticResource MutedText}" Margin="0,0,0,3" /><TextBox Style="{StaticResource EntryField}" Text="{Binding SelectedRow.DateText, Mode=OneWay}" AutomationProperties.Name="Date de l'opération" /></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="Mode" Style="{StaticResource MutedText}" Margin="0,0,0,3" /><TextBox Style="{StaticResource EntryField}" Text="{Binding SelectedRow.PaymentModeName, Mode=OneWay}" AutomationProperties.Name="Mode de paiement" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Tiers" Style="{StaticResource MutedText}" Margin="0,0,0,3" /><TextBox Style="{StaticResource EntryField}" Text="{Binding SelectedRow.PayeeName, Mode=OneWay}" AutomationProperties.Name="Tiers de l'opération" /></StackPanel>
                            <StackPanel Grid.Column="3"><TextBlock Text="Catégorie" Style="{StaticResource MutedText}" Margin="0,0,0,3" /><TextBox Style="{StaticResource EntryField}" Text="{Binding SelectedRow.CategoryName, Mode=OneWay}" AutomationProperties.Name="Catégorie de l'opération" /></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="Montant d'origine" Style="{StaticResource MutedText}" Margin="0,0,0,3" /><TextBox Style="{StaticResource EntryField}" TextAlignment="Right" AutomationProperties.Name="Montant d'origine">
                                <TextBox.Text><MultiBinding StringFormat="{}{0}{1}" Mode="OneWay"><Binding Path="SelectedRow.DebitText" /><Binding Path="SelectedRow.CreditText" /></MultiBinding></TextBox.Text>
                            </TextBox></StackPanel>
                            <StackPanel Grid.Column="5" Margin="0"><TextBlock Text="Opération" Style="{StaticResource MutedText}" Margin="0,0,0,3" /><StackPanel Orientation="Horizontal">
                                <Button Content="Nouvelle" Command="{x:Static local:WindowCommands.NewTransaction}" MinHeight="30" Padding="8,4" Margin="0,0,5,0" AutomationProperties.AutomationId="NewTransactionButton" />
                                <Button Content="Modifier" Command="{x:Static local:WindowCommands.EditTransaction}" MinHeight="30" Padding="8,4" AutomationProperties.AutomationId="EditTransactionButton" />
                            </StackPanel></StackPanel>
                        </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="{Binding StatusText, FallbackValue='Fichier → Nouveau dossier ou Ouvrir pour commencer'}" Style="{StaticResource MutedText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" AutomationProperties.AutomationId="StatusText" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                    <TextBlock x:Name="BackupStatus" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               MaxWidth="340" AutomationProperties.LiveSetting="Polite" Visibility="Collapsed" />
                    <Button x:Name="BackupCancel" Content="Annuler la sauvegarde" Click="BackupCancel_Click"
                            Margin="8,0,0,0" Visibility="Collapsed" />
                </StackPanel>
                <TextBlock x:Name="DevelopmentNotice" Grid.Column="2" Text="Version de développement — données fictives" Style="{StaticResource MutedText}" Margin="16,0,0,0" VerticalAlignment="Center" AutomationProperties.AutomationId="DevelopmentNotice" />
            </Grid>
        </Border>
    </Grid>
</Window>
