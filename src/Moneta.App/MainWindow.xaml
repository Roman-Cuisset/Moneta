<Window x:Class="Moneta.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Moneta — prototype de développement"
        Width="1100" Height="730" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FocusManager.FocusedElement="{Binding ElementName=AccountsSelector}">
    <Window.Resources>
        <Style TargetType="MenuItem">
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>
        <Style x:Key="UnavailableMenuItem" TargetType="MenuItem"
               BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="IsEnabled" Value="False" />
            <Setter Property="ToolTip" Value="Indisponible dans ce prototype : fonction non implémentée. Le raccourci indiqué n'est pas actif." />
        </Style>
        <Style x:Key="AmountText" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,2" />
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,2" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="ToolTip" Value="Tri désactivé : l'ordre chronologique est conservé pour lire les soldes progressifs. La largeur des colonnes reste réglable." />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="90" />
            <RowDefinition Height="5" />
            <RowDefinition Height="185" MinHeight="100" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" KeyboardNavigation.TabNavigation="Once"
              ToolTip="Ordre, séparateurs et accès Alt provisoires propres à Moneta ; ils ne constituent pas un relevé de BankPerfect.">
            <MenuItem Header="_Fichier">
                <MenuItem Header="_Ouvrir…" InputGestureText="Ctrl+O" Style="{StaticResource UnavailableMenuItem}" />
                <MenuItem Header="_Enregistrer" InputGestureText="Ctrl+S" Style="{StaticResource UnavailableMenuItem}" />
                <Separator />
                <MenuItem Header="_Importer">
                    <MenuItem Header="CSV…" Style="{StaticResource UnavailableMenuItem}" />
                    <MenuItem Header="QIF…" InputGestureText="Ctrl+Alt+Q" Style="{StaticResource UnavailableMenuItem}" />
                </MenuItem>
                <MenuItem Header="E_xporter">
                    <MenuItem Header="CSV…" Style="{StaticResource UnavailableMenuItem}" />
                    <MenuItem Header="QIF…" Style="{StaticResource UnavailableMenuItem}" />
                    <MenuItem Header="HTML…" Style="{StaticResource UnavailableMenuItem}" />
                    <MenuItem Header="XML…" Style="{StaticResource UnavailableMenuItem}" />
                    <MenuItem Header="Tableur…" Style="{StaticResource UnavailableMenuItem}" />
                </MenuItem>
                <MenuItem Header="Imprimer un RIB…" Style="{StaticResource UnavailableMenuItem}" />
                <MenuItem Header="Enregistrer sur disque externe…" Style="{StaticResource UnavailableMenuItem}" />
                <Separator />
                <MenuItem Header="_Quitter" Click="Quit_Click"
                          ToolTip="Ferme Moneta. Position provisoire propre à ce prototype, non confirmée dans la documentation de référence." />
            </MenuItem>
            <MenuItem Header="_Édition">
                <MenuItem Header="_Copier" Style="{StaticResource UnavailableMenuItem}" />
                <MenuItem Header="C_oller" Style="{StaticResource UnavailableMenuItem}" />
            </MenuItem>
            <MenuItem Header="_Comptes">
                <MenuItem Header="_Nouveau fichier de comptes…" InputGestureText="Ctrl+N" Style="{StaticResource UnavailableMenuItem}" />
                <MenuItem Header="_Gestion des comptes…" InputGestureText="Ctrl+G" Style="{StaticResource UnavailableMenuItem}" />
                <MenuItem Header="Mot de passe…" Style="{StaticResource UnavailableMenuItem}" />
                <Separator />
                <MenuItem Header="_Catégories…" Style="{StaticResource UnavailableMenuItem}" />
                <MenuItem Header="_Tiers…" InputGestureText="F5" Style="{StaticResource UnavailableMenuItem}" />
                <MenuItem Header="Modes de paiement…" Style="{StaticResource UnavailableMenuItem}" />
                <MenuItem Header="_Échéancier…" InputGestureText="Ctrl+E" Style="{StaticResource UnavailableMenuItem}" />
                <Separator />
                <MenuItem Header="Total des comptes…" Style="{StaticResource UnavailableMenuItem}" />
                <MenuItem Header="Relevé multi-comptes…" Style="{StaticResource UnavailableMenuItem}" />
                <MenuItem Header="Sauvegardes…" Style="{StaticResource UnavailableMenuItem}" />
            </MenuItem>
            <MenuItem Header="_Opérations">
                <MenuItem Header="_Supprimer" InputGestureText="Ctrl+Suppr" Style="{StaticResource UnavailableMenuItem}" />
                <MenuItem Header="Charger un tiers…" InputGestureText="F10" Style="{StaticResource UnavailableMenuItem}" />
                <MenuItem Header="Date de pointage…" InputGestureText="Ctrl+Maj+P" Style="{StaticResource UnavailableMenuItem}" />
                <Separator />
                <MenuItem Header="Saisie multiple…" InputGestureText="F2" Style="{StaticResource UnavailableMenuItem}" />
                <MenuItem Header="Modifier un groupe…" InputGestureText="Ctrl+M" Style="{StaticResource UnavailableMenuItem}" />
                <MenuItem Header="_Transfert de compte à compte…" InputGestureText="Ctrl+Maj+T" Style="{StaticResource UnavailableMenuItem}" />
                <MenuItem Header="Convertir une ligne en transfert…" Style="{StaticResource UnavailableMenuItem}" />
                <MenuItem Header="_Ventiler l'opération…" InputGestureText="F6" Style="{StaticResource UnavailableMenuItem}" />
                <MenuItem Header="Champs supplémentaires…" InputGestureText="F3" Style="{StaticResource UnavailableMenuItem}" />
                <MenuItem Header="Ajouter à l'échéancier…" Style="{StaticResource UnavailableMenuItem}" />
            </MenuItem>
            <MenuItem Header="_Affichage">
                <MenuItem Header="Affichage sur _2 lignes" InputGestureText="F4" Style="{StaticResource UnavailableMenuItem}" />
                <MenuItem Header="Dates de pointage" InputGestureText="F11" Style="{StaticResource UnavailableMenuItem}" />
                <MenuItem Header="Filtres enregistrés…" InputGestureText="F7" Style="{StaticResource UnavailableMenuItem}" />
                <MenuItem Header="Cacher les lignes inutiles" InputGestureText="Ctrl+H" Style="{StaticResource UnavailableMenuItem}" />
            </MenuItem>
            <MenuItem Header="O_utils">
                <MenuItem Header="_Options…" Style="{StaticResource UnavailableMenuItem}" />
                <Separator />
                <MenuItem Header="Budget mensuel…" InputGestureText="Ctrl+B" Style="{StaticResource UnavailableMenuItem}" />
                <MenuItem Header="Budget annuel…" Style="{StaticResource UnavailableMenuItem}" />
                <MenuItem Header="Graphiques…" Style="{StaticResource UnavailableMenuItem}" />
                <MenuItem Header="Totaux par catégories…" InputGestureText="Ctrl+T" Style="{StaticResource UnavailableMenuItem}" />
                <MenuItem Header="Totaux par tiers…" InputGestureText="Ctrl+Alt+T" Style="{StaticResource UnavailableMenuItem}" />
                <Separator />
                <MenuItem Header="Calcul automatique des champs…" InputGestureText="Ctrl+F" Style="{StaticResource UnavailableMenuItem}" />
                <MenuItem Header="Notes…" InputGestureText="Ctrl+Maj+N" Style="{StaticResource UnavailableMenuItem}" />
                <MenuItem Header="_Conversions de devises…" InputGestureText="Ctrl+D" Style="{StaticResource UnavailableMenuItem}" />
                <MenuItem Header="Inverser les monnaies…" Style="{StaticResource UnavailableMenuItem}" />
                <Separator />
                <MenuItem Header="Simulateur de crédit…" InputGestureText="Ctrl+L" Style="{StaticResource UnavailableMenuItem}" />
                <MenuItem Header="Calculatrice…" InputGestureText="Ctrl+Maj+C" Style="{StaticResource UnavailableMenuItem}" />
                <MenuItem Header="Conversions numériques…" Style="{StaticResource UnavailableMenuItem}" />
                <MenuItem Header="Vérifier une carte bancaire…" Style="{StaticResource UnavailableMenuItem}" />
            </MenuItem>
            <MenuItem Header="_Internet">
                <MenuItem Header="Sauvegarder par courriel…" InputGestureText="F9" Style="{StaticResource UnavailableMenuItem}" />
                <MenuItem Header="Sauvegarder en ligne…" InputGestureText="Maj+F9" Style="{StaticResource UnavailableMenuItem}"
                          ToolTip="Non implémenté. Libellé et raccourci de cette commande présentent aussi une contradiction documentaire non résolue." />
                <MenuItem Header="Télécharger les cours des titres…" Style="{StaticResource UnavailableMenuItem}" />
                <MenuItem Header="Mise à jour…" Style="{StaticResource UnavailableMenuItem}"
                          ToolTip="Non implémenté. Arborescence détaillée de cette commande non confirmée." />
            </MenuItem>
            <MenuItem Header="_Plugins">
                <MenuItem Header="Gérer les extensions…" Style="{StaticResource UnavailableMenuItem}" />
            </MenuItem>
            <MenuItem Header="_?">
                <MenuItem Header="Télécharger le manuel…" InputGestureText="Ctrl+F1" Style="{StaticResource UnavailableMenuItem}" />
                <Separator />
                <MenuItem Header="À _propos de Moneta…" Click="About_Click"
                          ToolTip="Présentation locale du prototype Moneta ; commande et position provisoires propres à Moneta." />
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1" Margin="10,8,10,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label Content="_Compte :" Target="{Binding ElementName=AccountsSelector}"
                   VerticalAlignment="Center" Padding="0,0,8,0" />
            <ComboBox x:Name="AccountsSelector" Grid.Column="1" MaxWidth="700"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      ItemsSource="{Binding Accounts}"
                      SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                      IsSynchronizedWithCurrentItem="False" MinHeight="30"
                      AutomationProperties.AutomationId="AccountsSelector"
                      AutomationProperties.Name="Compte affiché">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                    </Style>
                </ComboBox.ItemContainerStyle>
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="55" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding CurrencyCode}" Margin="8,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding BalanceText}" TextAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <StackPanel Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Solde du compte" FontSize="11" />
                <TextBlock Text="{Binding SelectedAccountBalanceText}" FontWeight="SemiBold"
                           AutomationProperties.Name="Solde du compte sélectionné" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Margin="10,2,10,6">
            <TextBlock x:Name="DevelopmentNotice"
                       Text="Version de développement — données fictives" FontWeight="SemiBold"
                       AutomationProperties.AutomationId="DevelopmentNotice" />
            <TextBlock Text="Disposition des menus provisoire" FontSize="11"
                       ToolTip="Ordre, séparateurs et accès Alt proposés pour Moneta, non confirmés pour BankPerfect. Quitter est placé provisoirement dans Fichier. Les commandes à emplacement inconnu ou contradictoire (notamment Remplacer, Enregistrer sous, Imprimer, Annuler/Refaire et Aide) sont omises plutôt que placées arbitrairement." />
        </StackPanel>

        <DataGrid x:Name="TransactionsGrid" Grid.Row="3" Margin="10,0"
                  ItemsSource="{Binding Rows}"
                  SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                  SelectionChanged="TransactionSelectionChanged"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserSortColumns="False" CanUserResizeColumns="True"
                  CanUserReorderColumns="False"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  IsSynchronizedWithCurrentItem="False" ClipboardCopyMode="None"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  HeadersVisibility="Column" RowHeight="27" GridLinesVisibility="Horizontal"
                  Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                  Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                  BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                  HorizontalGridLinesBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                  AutomationProperties.AutomationId="TransactionsGrid"
                  AutomationProperties.Name="Opérations fictives du compte sélectionné"
                  AutomationProperties.HelpText="Lecture seule. Navigation par flèches et Page précédente ou suivante. Tri désactivé pour conserver les soldes chronologiques.">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="92" MinWidth="80"
                                    ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Libellé" Binding="{Binding Label}" Width="*" MinWidth="150"
                                    ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Tiers" Binding="{Binding PayeeName}" Width="145" MinWidth="90"
                                    ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Catégorie" Binding="{Binding CategoryName}" Width="130" MinWidth="90"
                                    ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Débit" Binding="{Binding DebitText}" Width="112" MinWidth="95"
                                    ElementStyle="{StaticResource AmountText}" />
                <DataGridTextColumn Header="Crédit" Binding="{Binding CreditText}" Width="112" MinWidth="95"
                                    ElementStyle="{StaticResource AmountText}" />
                <DataGridTextColumn Header="Solde" Binding="{Binding BalanceText}" Width="145" MinWidth="110"
                                    ElementStyle="{StaticResource AmountText}" />
                <DataGridTextColumn Header="Pointage" Binding="{Binding MarkText}" Width="105" MinWidth="90"
                                    ElementStyle="{StaticResource CellText}" />
            </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Row="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                      Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                      Focusable="False" ToolTip="Ajuster la hauteur du relevé et du détail" />

        <GroupBox Grid.Row="5" Header="Détail de l'opération sélectionnée — lecture seule" Margin="10,0,10,6">
            <ScrollViewer x:Name="DetailsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="8,4" Focusable="False">
                <TextBlock x:Name="DetailsText" Text="{Binding SelectedRowDetails, TargetNullValue=''}"
                           TextWrapping="Wrap"
                           AutomationProperties.AutomationId="DetailsText" />
            </ScrollViewer>
        </GroupBox>

        <StatusBar Grid.Row="6">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="{Binding StatusText}" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="StatusText" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
