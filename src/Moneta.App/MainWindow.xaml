<Window xmlns:loc="clr-namespace:Moneta.App" x:Class="Moneta.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Moneta.App"
        Title="Moneta" Width="1280" Height="800" MinWidth="780" MinHeight="450"
        WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}"
        FocusManager.FocusedElement="{Binding ElementName=AccountsSelector}" Language="{loc:LocalizedLanguage}">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Close" Executed="Close_Executed" />
        <CommandBinding Command="{x:Static local:WindowCommands.About}" Executed="About_Executed" />
        <CommandBinding Command="{x:Static local:WindowCommands.CheckUpdates}" Executed="CheckUpdates_Executed" CanExecute="CheckUpdates_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.Settings}" Executed="Settings_Executed" />
        <CommandBinding Command="{x:Static local:WindowCommands.AddAccount}" Executed="AddAccount_Executed" CanExecute="AddAccount_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.AccountProperties}" Executed="AccountProperties_Executed" CanExecute="ManageAccount_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.ArchiveAccount}" Executed="SetAccountArchived_Executed" CanExecute="ManageAccount_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.ReactivateAccount}" Executed="SetAccountArchived_Executed" CanExecute="ManageAccount_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.MoveAccount}" Executed="MoveAccount_Executed" CanExecute="ManageAccount_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.DeleteAccount}" Executed="DeleteAccount_Executed" CanExecute="ManageAccount_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.Theme}" Executed="Theme_Executed" />
        <CommandBinding Command="{x:Static local:WindowCommands.New}" Executed="New_Executed" CanExecute="Available_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.Open}" Executed="Open_Executed" CanExecute="Available_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.ImportBankPerfect}" Executed="ImportBankPerfect_Executed" CanExecute="Available_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.Save}" Executed="Save_Executed" CanExecute="Save_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.SaveAs}" Executed="SaveAs_Executed" CanExecute="Save_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.Backup}" Executed="Backup_Executed" CanExecute="Backup_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.BackupHistory}" Executed="BackupHistory_Executed" CanExecute="BackupHistory_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.Schedule}" Executed="Schedule_Executed" CanExecute="Schedule_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.Restore}" Executed="Restore_Executed" CanExecute="Available_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.Demo}" Executed="Demo_Executed" CanExecute="Available_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.Search}" Executed="Search_Executed" CanExecute="Search_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.SearchFilters}" Executed="Search_Executed" CanExecute="Search_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.ClearSearch}" Executed="ClearSearch_Executed" CanExecute="Search_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.FinancialUndo}" CanExecute="Unavailable_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.FinancialRedo}" CanExecute="Unavailable_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.NewTransaction}" Executed="NewTransaction_Executed" CanExecute="NewTransaction_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.EditTransaction}" Executed="EditTransaction_Executed" CanExecute="SelectedTransaction_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.DeleteTransaction}" Executed="DeleteTransaction_Executed" CanExecute="SelectedTransaction_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.RefreshRates}" Executed="RefreshRates_Executed" CanExecute="RefreshRates_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.ShowRates}" Executed="ShowRates_Executed" CanExecute="Available_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.HistoricalConverter}" Executed="HistoricalFx_Executed" CanExecute="Available_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.HistoricalFlow}" Executed="HistoricalFx_Executed" CanExecute="HistoricalFx_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.HistoricalBalance}" Executed="HistoricalFx_Executed" CanExecute="HistoricalFx_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.Reports}" Executed="Reports_Executed" CanExecute="Reports_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.Budgets}" Executed="Reports_Executed" CanExecute="Reports_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.CategoryReports}" Executed="Reports_Executed" CanExecute="Reports_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.TogglePointing}" Executed="TogglePointing_Executed" CanExecute="Pointing_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.MarkTransactions}" Executed="Mark_Executed" CanExecute="Pointing_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.UnmarkTransactions}" Executed="Unmark_Executed" CanExecute="Pointing_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.MarkingDate}" Executed="MarkingDate_Executed" CanExecute="MarkingDate_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.ShowMarkingDates}" Executed="ShowMarkingDates_Executed" CanExecute="ShowMarkingDates_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.Reconcile}" Executed="Reconcile_Executed" CanExecute="Reconcile_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.ReleaseLegacyReconciliation}" Executed="ReleaseLegacy_Executed" CanExecute="ReleaseLegacy_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.NewTransfer}" Executed="NewTransfer_Executed" CanExecute="NewTransfer_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.OpenTransfer}" Executed="OpenTransfer_Executed" CanExecute="ReadTransfer_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.NavigateTransfer}" Executed="NavigateTransfer_Executed" CanExecute="ReadTransfer_CanExecute" />
        <CommandBinding Command="{x:Static local:WindowCommands.DeleteTransfer}" Executed="DeleteTransfer_Executed" CanExecute="DeleteTransfer_CanExecute" />
    </Window.CommandBindings>
    <Window.Resources>
        <!-- Géométries originales Moneta : aucune ressource ni forme extraite de BankPerfect. -->
        <Geometry x:Key="AccountsIcon">M3,4 H21 V20 H3 Z M8,4 V20 M3,10 H21 M12,8 H17 M12,14 H17</Geometry>
        <Geometry x:Key="OpenIcon">M2,19 V6 H9 L12,9 H21 L18,19 Z M2,11 H19</Geometry>
        <Geometry x:Key="SaveIcon">M4,3 H17 L21,7 V21 H4 Z M8,3 V10 H16 V3 M8,21 V14 H17 V21</Geometry>
        <Geometry x:Key="UndoIcon">M8,5 L3,10 L8,15 M3,10 H14 C22,10 22,20 14,20</Geometry>
        <Geometry x:Key="RedoIcon">M16,5 L21,10 L16,15 M21,10 H10 C2,10 2,20 10,20</Geometry>
        <Geometry x:Key="LockIcon">M5,10 H19 V21 H5 Z M8,10 V7 C8,1 16,1 16,7 V10 M12,14 V17</Geometry>
        <Geometry x:Key="BudgetIcon">M4,3 H20 V21 H4 Z M8,7 H16 M8,12 H11 M14,12 H16 M8,17 H11 M14,17 H16</Geometry>
        <Geometry x:Key="TotalsIcon">M18,4 H6 L12,12 L6,20 H18</Geometry>
        <Geometry x:Key="ChartIcon">M3,3 V21 H22 M7,17 V11 H10 V17 M14,17 V6 H17 V17</Geometry>
        <Geometry x:Key="FilterIcon">M3,4 H21 L14,12 V19 L10,21 V12 Z</Geometry>
        <Geometry x:Key="ScheduleIcon">M4,5 H20 V21 H4 Z M4,10 H20 M8,2 V8 M16,2 V8 M8,14 H10 M14,14 H16 M8,18 H10</Geometry>
        <Geometry x:Key="TransferIcon">M3,7 H20 M16,3 L20,7 L16,11 M21,17 H4 M8,13 L4,17 L8,21</Geometry>
        <Style x:Key="ToolIcon" TargetType="Path">
            <Setter Property="Width" Value="20" /><Setter Property="Height" Value="20" />
            <Setter Property="Stretch" Value="Uniform" /><Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="StrokeStartLineCap" Value="Round" /><Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" /><Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="ToolLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" /><Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SecondaryCellText" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RegisterCellStack" TargetType="StackPanel">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="9,3" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompactRegister, RelativeSource={RelativeSource AncestorType=local:MainWindow}}" Value="True">
                    <Setter Property="Margin" Value="9,1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RegisterSecondaryText" TargetType="TextBlock" BasedOn="{StaticResource SecondaryCellText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompactRegister, RelativeSource={RelativeSource AncestorType=local:MainWindow}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RegisterPointingButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="MinHeight" Value="26" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompactRegister, RelativeSource={RelativeSource AncestorType=local:MainWindow}}" Value="True">
                    <Setter Property="Padding" Value="5,1" />
                    <Setter Property="MinHeight" Value="22" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Background="{DynamicResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="10,4">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,16,0">
                    <Image Source="{StaticResource BrandSymbolSmall}" Width="24" Height="24" />
                    <TextBlock Text="Moneta" FontWeight="SemiBold" VerticalAlignment="Center" Margin="7,0,0,0" />
                </StackPanel>
                <Menu KeyboardNavigation.TabNavigation="Once" VerticalAlignment="Center" AutomationProperties.AutomationId="MainMenu">
                    <MenuItem Header="_Fichier">
                        <MenuItem Header="{loc:LocalizedText MainWindow.NewDocumentAccessKey}" Command="{x:Static local:WindowCommands.New}" AutomationProperties.AutomationId="NewDocumentCommand" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.OpenAccessKey}" Command="{x:Static local:WindowCommands.Open}" AutomationProperties.AutomationId="OpenDocumentCommand" />
                        <MenuItem Header="{loc:LocalizedText Common.SaveAccessKey}" Command="{x:Static local:WindowCommands.Save}" AutomationProperties.AutomationId="SaveDocumentCommand" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.SaveAsAccessKey}" Command="{x:Static local:WindowCommands.SaveAs}" AutomationProperties.AutomationId="SaveAsDocumentCommand" />
                        <Separator />
                        <MenuItem Header="{loc:LocalizedText MainWindow.BackUpDocumentAccessKey}" Command="{x:Static local:WindowCommands.Backup}" AutomationProperties.AutomationId="BackupDocumentCommand" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.RestoreFromBackupAccessKey}" Command="{x:Static local:WindowCommands.Restore}" AutomationProperties.AutomationId="RestoreDocumentCommand" />
                        <MenuItem Header="{loc:LocalizedText Common.BackupsAccessKey}">
                            <MenuItem Header="{loc:LocalizedText MainWindow.HistoryAccessKey}" Command="{x:Static local:WindowCommands.BackupHistory}" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{loc:LocalizedText MainWindow.DemonstrationModeAccessKey}" Command="{x:Static local:WindowCommands.Demo}" ToolTip="{loc:LocalizedText MainWindow.FictiveDataInMemoryWithoutPossibilityOfFinancial}" AutomationProperties.AutomationId="DemoDocumentCommand" />
                        <Separator />
                        <MenuItem Header="{loc:LocalizedText MainWindow.ImportAccessKey}">
                            <MenuItem Header="{loc:LocalizedText MainWindow.BankperfectBpAccessKey}" Command="{x:Static local:WindowCommands.ImportBankPerfect}" AutomationProperties.AutomationId="ImportBankPerfectCommand" />
                            <MenuItem Header="{loc:LocalizedText MainWindow.Csv}" Style="{StaticResource UnavailableMenuItem}" />
                            <MenuItem Header="{loc:LocalizedText MainWindow.Qif}" InputGestureText="Ctrl+Alt+Q" Style="{StaticResource UnavailableMenuItem}" />
                        </MenuItem>
                        <MenuItem Header="{loc:LocalizedText MainWindow.EXportAccessKey}">
                            <MenuItem Header="{loc:LocalizedText MainWindow.Csv}" Style="{StaticResource UnavailableMenuItem}" />
                            <MenuItem Header="{loc:LocalizedText MainWindow.Qif}" Style="{StaticResource UnavailableMenuItem}" />
                            <MenuItem Header="{loc:LocalizedText MainWindow.Html}" Style="{StaticResource UnavailableMenuItem}" />
                            <MenuItem Header="{loc:LocalizedText MainWindow.Xml}" Style="{StaticResource UnavailableMenuItem}" />
                            <MenuItem Header="{loc:LocalizedText MainWindow.Spreadsheet}" Style="{StaticResource UnavailableMenuItem}" />
                        </MenuItem>
                        <MenuItem Header="{loc:LocalizedText MainWindow.PrintARib}" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.SaveToExternalDisk}" Style="{StaticResource UnavailableMenuItem}" />
                        <Separator /><MenuItem Header="{loc:LocalizedText MainWindow.QuitAccessKey}" Command="ApplicationCommands.Close" />
                    </MenuItem>
                    <MenuItem Header="{loc:LocalizedText MainWindow.EditAccessKey}">
                        <MenuItem Header="{loc:LocalizedText MainWindow.CopyAccessKey}" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.PasteAccessKey}" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.UndoATransaction}" Command="{x:Static local:WindowCommands.FinancialUndo}" InputGestureText="Ctrl+Z (futur)" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.RedoATransaction}" Command="{x:Static local:WindowCommands.FinancialRedo}" InputGestureText="Ctrl+Y (futur)" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="{loc:LocalizedText Common.SearchAccessKey}" Command="{x:Static local:WindowCommands.Search}" CommandParameter="Focus" />
                    </MenuItem>
                    <MenuItem Header="{loc:LocalizedText MainWindow.ViewAccessKey}">
                        <MenuItem Header="{loc:LocalizedText Common.ThemeAccessKey}" SubmenuOpened="ThemeMenu_Opened">
                            <MenuItem x:Name="LightThemeItem" Header="{loc:LocalizedText MainWindow.LightAccessKey}" IsCheckable="True" Command="{x:Static local:WindowCommands.Theme}" CommandParameter="Light" />
                            <MenuItem x:Name="DarkThemeItem" Header="{loc:LocalizedText MainWindow.DarkAccessKey}" IsCheckable="True" Command="{x:Static local:WindowCommands.Theme}" CommandParameter="Dark" />
                        </MenuItem>
                        <MenuItem Header="{loc:LocalizedText RegisterDensity.Menu}">
                            <MenuItem x:Name="StandardRegisterItem" Header="{loc:LocalizedText RegisterDensity.Standard}" IsCheckable="True"
                                      Click="RegisterDensity_Click" Tag="Standard" AutomationProperties.AutomationId="RegisterStandard" />
                            <MenuItem x:Name="CompactRegisterItem" Header="{loc:LocalizedText RegisterDensity.Compact}" IsCheckable="True"
                                      Click="RegisterDensity_Click" Tag="Compact" AutomationProperties.AutomationId="RegisterCompact" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{loc:LocalizedText MainWindow.ViewOn2LinesAccessKey}" InputGestureText="F4" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem x:Name="ShowMarkingDatesItem" Header="{loc:LocalizedText MainWindow.ClearingDates}" IsCheckable="True" IsChecked="{Binding ShowMarkingDates, Mode=OneWay}" Command="{x:Static local:WindowCommands.ShowMarkingDates}" InputGestureText="{loc:LocalizedText Gestures.F11Registre}" AutomationProperties.AutomationId="ShowMarkingDatesCommand" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.AdvancedFilters}" Command="{x:Static local:WindowCommands.SearchFilters}" />
                        <MenuItem Header="{loc:LocalizedText Common.ClearFilters}" Command="{x:Static local:WindowCommands.ClearSearch}" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.HideUnnecessaryLines}" InputGestureText="Ctrl+H" Style="{StaticResource UnavailableMenuItem}" />
                    </MenuItem>
                    <MenuItem Header="{loc:LocalizedText Common.AccountsAccessKey}">
                        <MenuItem Header="{loc:LocalizedText MainWindow.NewAccountsDocumentAccessKey}" Command="{x:Static local:WindowCommands.New}" ToolTip="{loc:LocalizedText MainWindow.SameCommandAsFileNewDocument}" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.AddAccountAccessKey}" Command="{x:Static local:WindowCommands.AddAccount}" AutomationProperties.AutomationId="AddAccountCommand" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.AccountPropertiesAccessKey}" Command="{x:Static local:WindowCommands.AccountProperties}" AutomationProperties.AutomationId="AccountPropertiesCommand" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.ArchiveAccount}" Command="{x:Static local:WindowCommands.ArchiveAccount}" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.ReactivateAccount}" Command="{x:Static local:WindowCommands.ReactivateAccount}" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.MoveAccountUp}" Command="{x:Static local:WindowCommands.MoveAccount}" CommandParameter="Up" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.MoveAccountDown}" Command="{x:Static local:WindowCommands.MoveAccount}" CommandParameter="Down" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.DeleteUnusedAccount}" Command="{x:Static local:WindowCommands.DeleteAccount}" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.RegisterOfAllAccounts}" Command="{x:Static local:WindowCommands.SearchFilters}" CommandParameter="All" InputGestureText="" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.ShowArchivedAccounts}" IsCheckable="True" IsChecked="{Binding ShowArchivedAccounts, Mode=TwoWay}" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.Password}" Style="{StaticResource UnavailableMenuItem}" /><Separator />
                        <MenuItem Header="{loc:LocalizedText MainWindow.CategoriesAccessKey}" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.PayeesAccessKey}" InputGestureText="F5" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.PaymentMethods}" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.ScheduledTransactionsAccessKey}" Command="{x:Static local:WindowCommands.Schedule}" /><Separator />
                        <MenuItem Header="{loc:LocalizedText MainWindow.TotalAccounts}" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.MultiAccountStatement}" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.Backups}" Style="{StaticResource UnavailableMenuItem}" />
                    </MenuItem>
                    <MenuItem Header="{loc:LocalizedText MainWindow.TransactionsAccessKey}">
                        <MenuItem Header="{loc:LocalizedText MainWindow.NewTransactionAccessKey}" Command="{x:Static local:WindowCommands.NewTransaction}" InputGestureText="{loc:LocalizedText Gestures.CtrlEntréeRegistre}" AutomationProperties.AutomationId="NewTransactionCommand" />
                        <MenuItem Header="{loc:LocalizedText Common.EditAccessKey}" Command="{x:Static local:WindowCommands.EditTransaction}" InputGestureText="{loc:LocalizedText Gestures.MajEntréeRegistre}" AutomationProperties.AutomationId="EditTransactionCommand" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.DeleteAccessKey}" Command="{x:Static local:WindowCommands.DeleteTransaction}" InputGestureText="{loc:LocalizedText Gestures.SupprCtrlSupprRegistre}" AutomationProperties.AutomationId="DeleteTransactionCommand" />
                        <Separator />
                        <MenuItem Header="{loc:LocalizedText MainWindow.MarkSelectionAsClearedAccessKey}" Command="{x:Static local:WindowCommands.MarkTransactions}" AutomationProperties.AutomationId="MarkTransactionsCommand" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.MarkSelectionAsUnclearedAccessKey}" Command="{x:Static local:WindowCommands.UnmarkTransactions}" InputGestureText="{loc:LocalizedText Gestures.MajPRegistre}" AutomationProperties.AutomationId="UnmarkTransactionsCommand" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.BankReconciliationAccessKey}" Command="{x:Static local:WindowCommands.Reconcile}" InputGestureText="{loc:LocalizedText Gestures.CtrlMajRRegistre}" AutomationProperties.AutomationId="ReconcileCommand" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.ReExaminingAnInheritedCloseState}" Command="{x:Static local:WindowCommands.ReleaseLegacyReconciliation}" ToolTip="{loc:LocalizedText MainWindow.WithoutLinkedStatementExplicitReleaseWithMotiveAnd}" AutomationProperties.AutomationId="ReleaseLegacyCommand" />
                        <Separator />
                        <MenuItem Header="{loc:LocalizedText MainWindow.SelectAPayee}" InputGestureText="F10" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.ClearingDate}" Command="{x:Static local:WindowCommands.MarkingDate}" InputGestureText="{loc:LocalizedText Gestures.CtrlMajPRegistre}" AutomationProperties.AutomationId="MarkingDateCommand" /><Separator />
                        <MenuItem Header="{loc:LocalizedText MainWindow.BatchEntry}" InputGestureText="F2" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.EditGroup}" InputGestureText="Ctrl+M" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.TransferAccessKey}" Command="{x:Static local:WindowCommands.NewTransfer}" InputGestureText="{loc:LocalizedText Gestures.CtrlMajTRegistre}" AutomationProperties.AutomationId="NewTransferCommand" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.OpenTheLinkedTransfer}" Command="{x:Static local:WindowCommands.OpenTransfer}" AutomationProperties.AutomationId="OpenTransferCommand" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.ValorizeTheRecordedTransaction}" Command="{x:Static local:WindowCommands.HistoricalFlow}" />
                        <MenuItem Header="{loc:LocalizedText Common.OtherSideOfTransfer}" Command="{x:Static local:WindowCommands.NavigateTransfer}" AutomationProperties.AutomationId="NavigateTransferCommand" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.DeleteTheEntireTransfer}" Command="{x:Static local:WindowCommands.DeleteTransfer}" AutomationProperties.AutomationId="DeleteTransferCommand" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.ConvertALineToTransfer}" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.SplitTransactionAccessKey}" InputGestureText="F6" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.AdditionalFields}" InputGestureText="F3" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.AddToSchedule}" Style="{StaticResource UnavailableMenuItem}" />
                    </MenuItem>
                    <MenuItem Header="{loc:LocalizedText MainWindow.ReportsAccessKey}">
                        <MenuItem Header="{loc:LocalizedText MainWindow.OverviewAccessKey}" Command="{x:Static local:WindowCommands.Reports}" CommandParameter="0" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.IncomeAndExpenses}" Command="{x:Static local:WindowCommands.Reports}" CommandParameter="1" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.ByCategoryAccessKey}" Command="{x:Static local:WindowCommands.CategoryReports}" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.Charts}" Command="{x:Static local:WindowCommands.Reports}" CommandParameter="3" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.BalancesAsOf}" Command="{x:Static local:WindowCommands.Reports}" CommandParameter="4" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.Forecast}" Command="{x:Static local:WindowCommands.Reports}" CommandParameter="5" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.BudgetsAccessKey}" Command="{x:Static local:WindowCommands.Budgets}" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.ReportSnapshots}" Command="{x:Static local:WindowCommands.Reports}" CommandParameter="7" />
                    </MenuItem>
                    <MenuItem Header="{loc:LocalizedText MainWindow.ToolsAccessKey}">
                        <MenuItem Header="{loc:LocalizedText MainWindow.OptionsAccessKey}" Command="{x:Static local:WindowCommands.Settings}" /><Separator />
                        <MenuItem Header="{loc:LocalizedText MainWindow.ExchangeRatesAccessKey}" Command="{x:Static local:WindowCommands.ShowRates}" AutomationProperties.AutomationId="ShowRatesCommand" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.RefreshOfficialExchangeRates}" Command="{x:Static local:WindowCommands.RefreshRates}" AutomationProperties.AutomationId="RefreshRatesCommand" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.HistoricalCurrencyConverter}" Command="{x:Static local:WindowCommands.HistoricalConverter}" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.ConvertBalanceAsOfDate}" Command="{x:Static local:WindowCommands.HistoricalBalance}" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.MonthlyBudget}" Command="{x:Static local:WindowCommands.Budgets}" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.AnnualBudget}" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.Charts}" Command="{x:Static local:WindowCommands.Reports}" CommandParameter="3" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.TotalsByCategories}" Command="{x:Static local:WindowCommands.CategoryReports}" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.TotalsByPayee}" InputGestureText="Ctrl+Alt+T" Style="{StaticResource UnavailableMenuItem}" /><Separator />
                        <MenuItem Header="{loc:LocalizedText MainWindow.AutomaticFieldCalculation}" Style="{StaticResource UnavailableMenuItem}" ToolTip="{loc:LocalizedText MainWindow.FormerCtrlFBankperfectConflictDocumentedWithSearch}" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.Notes}" InputGestureText="{loc:LocalizedText Gestures.CtrlMajN}" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.CurrencyConversionsAccessKey}" InputGestureText="Ctrl+D" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.ReversingCurrencies}" Style="{StaticResource UnavailableMenuItem}" /><Separator />
                        <MenuItem Header="{loc:LocalizedText MainWindow.CreditSimulator}" InputGestureText="Ctrl+L" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.Calculator}" InputGestureText="{loc:LocalizedText Gestures.CtrlMajC}" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.DigitalConversions}" Style="{StaticResource UnavailableMenuItem}" />
                        <MenuItem Header="{loc:LocalizedText MainWindow.CheckACreditCard}" Style="{StaticResource UnavailableMenuItem}" />
