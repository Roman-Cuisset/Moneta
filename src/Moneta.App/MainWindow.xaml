                    </TextBlock>
                </Border>
                <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="6" Margin="0,8,0,0" Padding="10,7">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,7">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="‹" Width="30" Padding="5,3" Click="PreviousPage_Click" IsEnabled="{Binding CanPreviousPage}" AutomationProperties.AutomationId="PreviousLedgerPage" AutomationProperties.Name="{loc:LocalizedText Common.PreviousPage}" />
                                <TextBlock Text="{Binding PageStatusText}" VerticalAlignment="Center" Margin="8,0" Foreground="{DynamicResource MutedBrush}" />
                                <Button Content="›" Width="30" Padding="5,3" Click="NextPage_Click" IsEnabled="{Binding CanNextPage}" AutomationProperties.AutomationId="NextLedgerPage" AutomationProperties.Name="{loc:LocalizedText Common.NextPage}" />
                            </StackPanel>
                            <WrapPanel>
                                <Button Content="{loc:LocalizedText MainWindow.New}" Command="{x:Static local:WindowCommands.NewTransaction}" Style="{StaticResource PrimaryButton}" Margin="0,0,5,0" AutomationProperties.AutomationId="NewTransactionButton" />
                                <Button Content="{loc:LocalizedText MainWindow.Modify}" Command="{x:Static local:WindowCommands.EditTransaction}" Margin="0,0,8,0" AutomationProperties.AutomationId="EditTransactionButton" />
                                <TextBlock Text="{loc:LocalizedText MainWindow.DraftCtrlS}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,4,6,4" />
                            </WrapPanel>
                        </DockPanel>
                        <local:QuickEntry x:Name="QuickTransaction" IsEnabled="False" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="{Binding StatusText, FallbackValue='Fichier → Nouveau dossier ou Ouvrir pour commencer'}" Style="{StaticResource MutedText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" AutomationProperties.AutomationId="StatusText" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                    <TextBlock x:Name="BackupStatus" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               MaxWidth="340" AutomationProperties.LiveSetting="Polite" Visibility="Collapsed" />
                    <Button x:Name="BackupCancel" Content="{loc:LocalizedText Common.CancelBackup}" Click="BackupCancel_Click"
                            Margin="8,0,0,0" Visibility="Collapsed" />
                </StackPanel>
                <TextBlock x:Name="DevelopmentNotice" Grid.Column="2" Text="{loc:LocalizedText MainWindow.DevelopmentVersionFictitiousData}" Style="{StaticResource MutedText}" Margin="16,0,0,0" VerticalAlignment="Center" AutomationProperties.AutomationId="DevelopmentNotice" />
            </Grid>
        </Border>
    </Grid>
</Window>
