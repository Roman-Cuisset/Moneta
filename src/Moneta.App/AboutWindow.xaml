<Window x:Class="Moneta.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="À propos de Moneta" Width="530" SizeToContent="Height" MaxHeight="650"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Style="{StaticResource {x:Type Window}}">
    <Border Padding="28" Background="{DynamicResource SurfaceBrush}">
        <StackPanel>
            <TextBlock Text="Moneta" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="Un espace de travail local, indépendant." Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,22" />
            <TextBlock Text="Version de développement — stockage local des comptes" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="Dossiers .moneta SQLite, comptes multidevises et sauvegarde/restauration vérifiées. Les opérations restent limitées au mode démonstration en mémoire ; aucune saisie financière ni conversion de change. Validez les parcours sur des données fictives avant tout usage réel." TextWrapping="Wrap" Margin="0,10,0,12" />
            <TextBlock Text="Les commandes grisées, leurs raccourcis et les filtres ne sont pas disponibles. Les soldes pointés et prévisionnels ne sont pas calculés." TextWrapping="Wrap" Margin="0,0,0,12" />
            <TextBlock Text="L'organisation suit la référence BankPerfect ; les styles et pictogrammes sont créés pour Moneta. Les sous-menus non observés restent documentaires. Le contraste élevé Windows est prioritaire sur le thème choisi." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,24" />
            <Button Content="Fermer" HorizontalAlignment="Right" MinWidth="100" IsDefault="True" IsCancel="True" Click="Close_Click" />
        </StackPanel>
    </Border>
</Window>
