<Window x:Class="Moneta.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="À propos de Moneta" Width="450" SizeToContent="Height" MaxHeight="540"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Style="{StaticResource {x:Type Window}}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <DockPanel Margin="0,0,0,18">
                <Image DockPanel.Dock="Left" Source="{StaticResource BrandSymbol}" Width="64" Height="64" Margin="0,0,14,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Moneta" Style="{StaticResource WindowHeading}" />
                    <TextBlock Text="Gestion financière personnelle" Style="{StaticResource BodyMuted}" />
                </StackPanel>
            </DockPanel>
            <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Version de développement" Style="{StaticResource SectionHeading}" />
                    <TextBlock Text="Comptes multidevises, échéancier, budgets et rapports. Vos dossiers Moneta et leurs sauvegardes sont stockés localement." Style="{StaticResource BodyMuted}" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
            <Button Content="_Fermer" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" MinWidth="100" IsDefault="True" IsCancel="True" Click="Close_Click" />
        </StackPanel>
    </ScrollViewer>
</Window>
