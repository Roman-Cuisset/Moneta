<Window xmlns:loc="clr-namespace:Moneta.App" x:Class="Moneta.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{loc:LocalizedText Common.AboutMoneta}" Width="480" SizeToContent="Height" MaxHeight="640"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Style="{StaticResource {x:Type Window}}" Language="{loc:LocalizedLanguage}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <DockPanel Margin="0,0,0,18">
                <Image DockPanel.Dock="Left" Source="{StaticResource BrandSymbol}" Width="64" Height="64" Margin="0,0,14,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Moneta" Style="{StaticResource WindowHeading}" />
                    <TextBlock Text="{loc:LocalizedText AboutWindow.PersonalFinancialManagement}" Style="{StaticResource BodyMuted}" />
                </StackPanel>
            </DockPanel>

            <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock x:Name="VersionText" Style="{StaticResource SectionHeading}" />
                    <TextBlock Text="{loc:LocalizedText AboutWindow.MulticurrencyAccountsSchedulesBudgetsAndReportsYourMoneta}"
                               Style="{StaticResource BodyMuted}" TextWrapping="Wrap" Margin="0,5,0,0" />
                    <TextBlock Text="{loc:LocalizedText AboutWindow.ProjectBy}"
                               Style="{StaticResource BodyMuted}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{loc:LocalizedText AboutWindow.LicenseSummary}" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="{loc:LocalizedText AboutWindow.ViewLicense}" Click="OpenLicense_Click"
                                Padding="10,6" Margin="0,0,8,8" MinHeight="32"
                                AutomationProperties.AutomationId="AboutViewLicense" />
                        <Button Content="{loc:LocalizedText AboutWindow.ThirdPartyNotices}" Click="OpenNotices_Click"
                                Padding="10,6" Margin="0,0,8,8" MinHeight="32"
                                AutomationProperties.AutomationId="AboutThirdPartyNotices" />
                        <Button Content="{loc:LocalizedText AboutWindow.SourceCode}" Click="OpenRepository_Click"
                                Padding="10,6" Margin="0,0,8,8" MinHeight="32"
                                AutomationProperties.AutomationId="AboutRepository" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{loc:LocalizedText AboutWindow.IndependentNotice}"
                       Style="{StaticResource BodyMuted}" TextWrapping="Wrap" Margin="0,0,0,18" />

            <Button Content="{loc:LocalizedText Common.Close}" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right" MinWidth="100" IsDefault="True" IsCancel="True" Click="Close_Click"
                    AutomationProperties.AutomationId="AboutClose" />
        </StackPanel>
    </ScrollViewer>
</Window>
