<Window xmlns:loc="clr-namespace:Moneta.App" x:Class="Moneta.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{loc:LocalizedText Common.AboutMoneta}" Width="450" SizeToContent="Height" MaxHeight="540"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Style="{StaticResource {x:Type Window}}" Language="{loc:LocalizedLanguage}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <DockPanel Margin="0,0,0,18">
                <Image DockPanel.Dock="Left" Source="{StaticResource BrandSymbol}" Width="64" Height="64" Margin="0,0,14,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Moneta" Style="{StaticResource WindowHeading}" />
                    <TextBlock Text="{loc:LocalizedText AboutWindow.PersonalFinancialManagement}" Style="{StaticResource BodyMuted}" />
                </StackPanel>
            </DockPanel>
            <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock x:Name="VersionText" Style="{StaticResource SectionHeading}" />
                    <TextBlock Text="{loc:LocalizedText AboutWindow.MulticurrencyAccountsSchedulesBudgetsAndReportsYourMoneta}" Style="{StaticResource BodyMuted}" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
            <Button Content="_Fermer" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" MinWidth="100" IsDefault="True" IsCancel="True" Click="Close_Click" />
        </StackPanel>
    </ScrollViewer>
</Window>
