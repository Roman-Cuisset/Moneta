<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Product>Moneta</Product>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../assets/branding/moneta.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Moneta.Localization" />
    <Resource Include="../../assets/branding/moneta.ico" Link="Branding/moneta.ico" />
    <Resource Include="../../assets/branding/moneta-256.png" Link="Branding/moneta-256.png" />
    <Resource Include="../../assets/branding/moneta-24.png" Link="Branding/moneta-24.png" />
    <None Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../packaging/notices/*" Link="ThirdPartyNotices/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../Moneta.BankPerfect/THIRD-PARTY-NOTICE.md" Link="ThirdPartyNotices/BankPerfect-V5.NOTICE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="../Moneta.Core/Moneta.Core.csproj" />
    <ProjectReference Include="../Moneta.Infrastructure/Moneta.Infrastructure.csproj" />
    <ProjectReference Include="../Moneta.Updates/Moneta.Updates.csproj" />
  </ItemGroup>
</Project>
