<Window xmlns:loc="clr-namespace:Moneta.App" x:Class="Moneta.App.RatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{loc:LocalizedText RatesWindow.ExchangeRatesMoneta}" Width="980" Height="780" MinWidth="720" MinHeight="500"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Language="{loc:LocalizedLanguage}"
        Style="{StaticResource {x:Type Window}}" AutomationProperties.AutomationId="RatesWindow">
    <Window.Resources>
        <Style x:Key="QuoteText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{loc:LocalizedText RatesWindow.OfficialRatesAndIndicativeConversions}" Style="{StaticResource WindowHeading}" />
            <TextBlock Text="{loc:LocalizedText RatesWindow.ValorizationOnlyTheAccountsTransactionsAndAmountsOf}"
                       TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,12" />
            <WrapPanel>
                <StackPanel Margin="0,0,16,0">
                    <Label Content="_Fournisseur" Target="{Binding ElementName=ProviderChoice}" />
                    <ComboBox x:Name="ProviderChoice" MinWidth="245" SelectionChanged="Provider_Changed"
                              AutomationProperties.AutomationId="RatesProvider" AutomationProperties.Name="{loc:LocalizedText RatesWindow.OfficialSourceSelected}">
                        <ComboBoxItem Content="{loc:LocalizedText RatesWindow.NbrbBynReference}" Tag="NBRB" />
                        <ComboBoxItem Content="{loc:LocalizedText RatesWindow.CbrRubReference}" Tag="CBR" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <Label Content="{loc:LocalizedText RatesWindow.DateRequestedMmDdYyyyAccessKey}" Target="{Binding ElementName=QueryDate}" />
                    <TextBox x:Name="QueryDate" Width="190" MaxLength="10" AutomationProperties.AutomationId="RatesDate" AutomationProperties.Name="{loc:LocalizedText RatesWindow.RequestedDateOfQuotationsDayMonthYear}" />
                </StackPanel>
                <Button Content="{loc:LocalizedText RatesWindow.CheckCacheAccessKey}" Click="LoadDate_Click" VerticalAlignment="Bottom" Margin="0,0,8,0"
                        AutomationProperties.AutomationId="LoadRatesDate" />
                <Button x:Name="RefreshButton" Content="{loc:LocalizedText Common.UpdateAccessKey}" Click="Refresh_Click" VerticalAlignment="Bottom" Margin="0,0,8,0"
                        AutomationProperties.AutomationId="RefreshOfficialRates" />
                <Button x:Name="CancelRefreshButton" Content="{loc:LocalizedText RatesWindow.CancelRequest}" Click="CancelRefresh_Click" VerticalAlignment="Bottom"
                        AutomationProperties.AutomationId="CancelRatesRefresh" />
            </WrapPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,12,0,10">
            <TextBlock x:Name="RateStatus" TextWrapping="Wrap" AutomationProperties.AutomationId="RatesStatus"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="RateDates" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"
                       AutomationProperties.AutomationId="RatesDates" />
        </StackPanel>
        <TabControl Grid.Row="2">
            <TabItem Header="{loc:LocalizedText RatesWindow.RatingsAccessKey}">
                <DataGrid x:Name="QuotesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          CanUserDeleteRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          HeadersVisibility="Column" AutomationProperties.AutomationId="OfficialQuotes">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:LocalizedText RatesWindow.Code}" Binding="{Binding Code}" Width="68" MinWidth="68" ElementStyle="{StaticResource QuoteText}" />
                        <DataGridTextColumn Header="{loc:LocalizedText RatesWindow.Currency}" Binding="{Binding Name}" Width="*" MinWidth="170" ElementStyle="{StaticResource QuoteText}" />
                        <DataGridTextColumn Header="{loc:LocalizedText RatesWindow.Nominal}" Binding="{Binding Nominal}" Width="100" MinWidth="100" ElementStyle="{StaticResource QuoteText}" />
                        <DataGridTextColumn Header="{loc:LocalizedText RatesWindow.OfficialValue}" Binding="{Binding Value}" Width="125" MinWidth="125" ElementStyle="{StaticResource QuoteText}" />
                        <DataGridTextColumn Header="{loc:LocalizedText Common.Reference}" Binding="{Binding Reference}" Width="90" MinWidth="90" ElementStyle="{StaticResource QuoteText}" />
                        <DataGridTextColumn Header="{loc:LocalizedText RatesWindow.IdentifierPrecision}" Binding="{Binding Note}" Width="220" MinWidth="220" ElementStyle="{StaticResource QuoteText}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="{loc:LocalizedText RatesWindow.LocalHistoryAccessKey}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              CanUserDeleteRows="False" HeadersVisibility="Column" SelectionMode="Single"
                              AutomationProperties.AutomationId="RatesHistory">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:LocalizedText RatesWindow.Effect}" Binding="{Binding Effective}" Width="110" />
                            <DataGridTextColumn Header="{loc:LocalizedText RatesWindow.Request}" Binding="{Binding Requested}" Width="110" />
                            <DataGridTextColumn Header="{loc:LocalizedText RatesWindow.Recovered}" Binding="{Binding Retrieved}" Width="170" />
                            <DataGridTextColumn Header="{loc:LocalizedText RatesWindow.Sha256Content}" Binding="{Binding Hash}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" Text="{loc:LocalizedText RatesWindow.UpTo100RecentPublicationsEnteringADate}"
                               TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" />
                </Grid>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="{loc:LocalizedText RatesWindow.ConvertAnAmountResultRoundedOnlyOnceAu}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
            <WrapPanel Margin="0,6,0,0">
                <TextBox x:Name="ConvertInput" Width="150" Text="1000,00" TextAlignment="Right" Margin="0,0,8,0"
                         AutomationProperties.AutomationId="RateConvertAmount" AutomationProperties.Name="{loc:LocalizedText RatesWindow.AmountToBeConvertedFrenchFormat}" />
                <ComboBox x:Name="ConvertSource" Width="90" DisplayMemberPath="Code" Margin="0,0,8,0" AutomationProperties.AutomationId="RateConvertSource" AutomationProperties.Name="{loc:LocalizedText RatesWindow.CurrencyOfAmountToBeConverted}" />
                <TextBlock Text="→" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="ConvertTarget" Width="90" DisplayMemberPath="Code" Margin="0,0,8,0" AutomationProperties.AutomationId="RateConvertTarget" AutomationProperties.Name="{loc:LocalizedText RatesWindow.ConversionDestinationCurrency}" />
                <Button Content="{loc:LocalizedText RatesWindow.COnvertAccessKey}" Click="Convert_Click" AutomationProperties.AutomationId="ConvertRateAmount" />
            </WrapPanel>
            <TextBlock x:Name="ConversionResult" Margin="0,6,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="RateConversionResult" />
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource NegativeBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                       AutomationProperties.AutomationId="RatesError" AutomationProperties.LiveSetting="Assertive" />
        </StackPanel>
        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock x:Name="TraceInformation" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,12,0" />
            <Button Content="_Fermer" IsCancel="True" MinWidth="100" HorizontalAlignment="Right" AutomationProperties.AutomationId="CloseRates" />
        </DockPanel>
    </Grid>
</Window>
