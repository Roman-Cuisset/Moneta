<Window x:Class="Moneta.App.RatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cours de change — Moneta" Width="980" Height="780" MinWidth="720" MinHeight="500"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Language="fr-FR"
        Style="{StaticResource {x:Type Window}}" AutomationProperties.AutomationId="RatesWindow">
    <Window.Resources>
        <Style x:Key="QuoteText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Cours officiels et conversions indicatives" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Valorisation seulement : les comptes, opérations et montants des virements ne sont jamais modifiés."
                       TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,12" />
            <WrapPanel>
                <StackPanel Margin="0,0,16,0">
                    <Label Content="_Fournisseur" Target="{Binding ElementName=ProviderChoice}" />
                    <ComboBox x:Name="ProviderChoice" MinWidth="245" SelectionChanged="Provider_Changed"
                              AutomationProperties.AutomationId="RatesProvider" AutomationProperties.Name="Source officielle sélectionnée">
                        <ComboBoxItem Content="NBRB — référence BYN" Tag="NBRB" />
                        <ComboBoxItem Content="CBR — référence RUB" Tag="CBR" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <Label Content="_Date demandée (jj/mm/aaaa)" Target="{Binding ElementName=QueryDate}" />
                    <TextBox x:Name="QueryDate" Width="190" MaxLength="10" AutomationProperties.AutomationId="RatesDate" />
                </StackPanel>
                <Button Content="_Consulter le cache" Click="LoadDate_Click" VerticalAlignment="Bottom" Margin="0,0,8,0"
                        AutomationProperties.AutomationId="LoadRatesDate" />
                <Button x:Name="RefreshButton" Content="_Actualiser" Click="Refresh_Click" VerticalAlignment="Bottom" Margin="0,0,8,0"
                        AutomationProperties.AutomationId="RefreshOfficialRates" />
                <Button x:Name="CancelRefreshButton" Content="Annuler la requête" Click="CancelRefresh_Click" VerticalAlignment="Bottom"
                        AutomationProperties.AutomationId="CancelRatesRefresh" />
            </WrapPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,12,0,10">
            <TextBlock x:Name="RateStatus" TextWrapping="Wrap" AutomationProperties.AutomationId="RatesStatus"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="RateDates" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"
                       AutomationProperties.AutomationId="RatesDates" />
        </StackPanel>
        <TabControl Grid.Row="2">
            <TabItem Header="_Cotations">
                <DataGrid x:Name="QuotesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          CanUserDeleteRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          HeadersVisibility="Column" AutomationProperties.AutomationId="OfficialQuotes">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="68" MinWidth="68" ElementStyle="{StaticResource QuoteText}" />
                        <DataGridTextColumn Header="Monnaie" Binding="{Binding Name}" Width="*" MinWidth="170" ElementStyle="{StaticResource QuoteText}" />
                        <DataGridTextColumn Header="Nominal" Binding="{Binding Nominal}" Width="100" MinWidth="100" ElementStyle="{StaticResource QuoteText}" />
                        <DataGridTextColumn Header="Valeur officielle" Binding="{Binding Value}" Width="125" MinWidth="125" ElementStyle="{StaticResource QuoteText}" />
                        <DataGridTextColumn Header="Référence" Binding="{Binding Reference}" Width="90" MinWidth="90" ElementStyle="{StaticResource QuoteText}" />
                        <DataGridTextColumn Header="Identifiant / précision" Binding="{Binding Note}" Width="220" MinWidth="220" ElementStyle="{StaticResource QuoteText}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="_Historique local">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              CanUserDeleteRows="False" HeadersVisibility="Column" SelectionMode="Single"
                              AutomationProperties.AutomationId="RatesHistory">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Effet" Binding="{Binding Effective}" Width="110" />
                            <DataGridTextColumn Header="Requête" Binding="{Binding Requested}" Width="110" />
                            <DataGridTextColumn Header="Récupéré" Binding="{Binding Retrieved}" Width="170" />
                            <DataGridTextColumn Header="SHA-256 du contenu" Binding="{Binding Hash}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" Text="100 publications récentes au plus. Saisir une date ci-dessus consulte aussi les archives plus anciennes. Les publications futures ne sont pas utilisées avant leur date d’effet."
                               TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" />
                </Grid>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="Convertir un montant — résultat arrondi une seule fois, au pair, dans la devise de destination" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
            <WrapPanel Margin="0,6,0,0">
                <TextBox x:Name="ConvertInput" Width="150" Text="1000,00" TextAlignment="Right" Margin="0,0,8,0"
                         AutomationProperties.AutomationId="RateConvertAmount" AutomationProperties.Name="Montant à convertir, format français" />
                <ComboBox x:Name="ConvertSource" Width="90" DisplayMemberPath="Code" Margin="0,0,8,0" AutomationProperties.AutomationId="RateConvertSource" />
                <TextBlock Text="→" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="ConvertTarget" Width="90" DisplayMemberPath="Code" Margin="0,0,8,0" AutomationProperties.AutomationId="RateConvertTarget" />
                <Button Content="C_onvertir" Click="Convert_Click" AutomationProperties.AutomationId="ConvertRateAmount" />
            </WrapPanel>
            <TextBlock x:Name="ConversionResult" Margin="0,6,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="RateConversionResult" />
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource NegativeBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                       AutomationProperties.AutomationId="RatesError" AutomationProperties.LiveSetting="Assertive" />
        </StackPanel>
        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock x:Name="TraceInformation" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,12,0" />
            <Button Content="_Fermer" IsCancel="True" MinWidth="100" HorizontalAlignment="Right" AutomationProperties.AutomationId="CloseRates" />
        </DockPanel>
    </Grid>
</Window>
