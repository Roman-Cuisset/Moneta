<Window x:Class="Moneta.App.ScheduleWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Échéancier — Moneta" Width="1050" Height="610" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource {x:Type Window}}"
        PreviewKeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="MoneyCell" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Margin" Value="4,0,8,0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Échéancier" Style="{StaticResource WindowHeading}" Margin="0,0,0,10" />
        <TabControl x:Name="Tabs" Grid.Row="1">
            <TabItem Header="_Occurrences">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <ComboBox x:Name="Filter" SelectedIndex="0" Width="180" DockPanel.Dock="Left"
                                  SelectionChanged="Filter_Changed" AutomationProperties.Name="Filtre des occurrences">
                            <ComboBoxItem Content="Toutes les échéances"/><ComboBoxItem Content="À venir"/><ComboBoxItem Content="En retard"/>
                            <ComboBoxItem Content="Aujourd’hui"/><ComboBoxItem Content="Ce mois"/>
                        </ComboBox>
                        <TextBlock x:Name="PageText" Margin="10,0,0,0" VerticalAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </DockPanel>
                    <DataGrid x:Name="Occurrences" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False"
                              SelectionMode="Single" CanUserAddRows="False" CanUserSortColumns="False" SelectionChanged="Selection_Changed"
                              EnableRowVirtualization="True" AutomationProperties.Name="Occurrences prévues">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date prévue" Binding="{Binding Date}" Width="100"/>
                            <DataGridTextColumn Header="Libellé" Binding="{Binding Label}" Width="2*" MinWidth="125"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="85"/>
                            <DataGridTextColumn Header="Compte" Binding="{Binding Accounts}" Width="2*" MinWidth="125"/>
                            <DataGridTextColumn Header="Montant natif" Binding="{Binding Amount}" Width="155" ElementStyle="{StaticResource MoneyCell}"/>
                            <DataGridTextColumn Header="Fréquence" Binding="{Binding Frequency}" Width="120"/>
                            <DataGridTextColumn Header="État" Binding="{Binding State}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                        <Button x:Name="PreviousPage" Content="‹" Click="Previous_Click" AutomationProperties.Name="Page précédente" Margin="0,0,4,4"/>
                        <Button x:Name="NextPage" Content="›" Click="Next_Click" AutomationProperties.Name="Page suivante" Margin="0,0,12,4"/>
                        <Button x:Name="Post" Content="_Confirmer l’occurrence…" Style="{StaticResource PrimaryButton}" Click="Post_Click" Margin="0,0,6,4"/>
                        <Button x:Name="Defer" Content="_Reporter…" Click="Defer_Click" Margin="0,0,6,4"/>
                        <Button x:Name="Skip" Content="_Ignorer…" Click="Skip_Click" Margin="0,0,6,4"/>
                    </WrapPanel>
                </Grid>
            </TabItem>
            <TabItem Header="_Programmations">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ComboBox x:Name="PlanFilter" HorizontalAlignment="Left" Width="180" SelectedIndex="0" Margin="0,0,0,8"
                              SelectionChanged="PlanFilter_Changed" AutomationProperties.Name="Filtre des programmations">
                        <ComboBoxItem Content="Toutes"/><ComboBoxItem Content="Suspendues"/><ComboBoxItem Content="Supprimées"/>
                    </ComboBox>
                    <DataGrid x:Name="Plans" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False"
                              CanUserAddRows="False" SelectionMode="Single" SelectionChanged="Selection_Changed"
                              EnableRowVirtualization="True" AutomationProperties.Name="Programmations">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Prochaine date" Binding="{Binding Next}" Width="110"/>
                            <DataGridTextColumn Header="Libellé" Binding="{Binding Label}" Width="2*" MinWidth="120"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="85"/>
                            <DataGridTextColumn Header="Compte" Binding="{Binding Accounts}" Width="2*" MinWidth="125"/>
                            <DataGridTextColumn Header="Montant natif" Binding="{Binding Amount}" Width="155" ElementStyle="{StaticResource MoneyCell}"/>
                            <DataGridTextColumn Header="Fréquence" Binding="{Binding Frequency}" Width="115"/>
                            <DataGridTextColumn Header="État" Binding="{Binding State}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                        <Button x:Name="Edit" Content="_Modifier…" Click="Edit_Click" Margin="0,0,6,4"/>
                        <Button x:Name="Suspend" Content="_Suspendre" Click="Suspend_Click" Margin="0,0,6,4"/>
                        <Button x:Name="Retire" Content="_Supprimer la programmation…" Style="{StaticResource DangerButton}" Click="Retire_Click" Margin="0,0,6,4"/>
                    </WrapPanel>
                </Grid>
            </TabItem>
            <TabItem Header="_Historique">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ComboBox x:Name="HistoryFilter" HorizontalAlignment="Left" Width="205" SelectedIndex="0" Margin="0,0,0,8"
                              SelectionChanged="HistoryFilter_Changed" AutomationProperties.Name="Filtre de l’historique">
                        <ComboBoxItem Content="Toutes les décisions"/><ComboBoxItem Content="Écritures comptabilisées"/>
                    </ComboBox>
                    <DataGrid x:Name="History" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                              EnableRowVirtualization="True" AutomationProperties.Name="Historique des décisions">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date d’origine" Binding="{Binding Original}" Width="105"/>
                            <DataGridTextColumn Header="Date retenue" Binding="{Binding Date}" Width="105"/>
                            <DataGridTextColumn Header="Libellé" Binding="{Binding Label}" Width="2*" MinWidth="130"/>
                            <DataGridTextColumn Header="Compte" Binding="{Binding Accounts}" Width="*" MinWidth="125"/>
                            <DataGridTextColumn Header="Montant natif" Binding="{Binding Amount}" Width="155" ElementStyle="{StaticResource MoneyCell}"/>
                            <DataGridTextColumn Header="Décision" Binding="{Binding State}" Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                        <Button x:Name="PreviousHistory" Content="‹" Click="PreviousHistory_Click" AutomationProperties.Name="Page précédente de l’historique" Margin="0,0,4,4"/>
                        <Button x:Name="NextHistory" Content="›" Click="NextHistory_Click" AutomationProperties.Name="Page suivante de l’historique" Margin="0,0,8,4"/>
                        <TextBlock x:Name="HistoryPageText" VerticalAlignment="Center"/>
                    </WrapPanel>
                </Grid>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="2" x:Name="Status" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
        <WrapPanel Grid.Row="3" Margin="0,8,0,0">
            <Button x:Name="NewPlan" Content="_Nouvelle échéance…" Style="{StaticResource PrimaryButton}" Click="New_Click" Margin="0,0,6,4"/>
            <Button x:Name="SaveDraft" Content="_Enregistrer le dossier (Ctrl+S)" Click="Save_Click" Margin="0,0,6,4"/>
            <Button Content="_Fermer" IsCancel="True" Margin="0,0,6,4"/>
        </WrapPanel>
    </Grid>
</Window>
