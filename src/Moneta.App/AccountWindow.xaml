<Window x:Class="Moneta.App.AccountWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Ajouter un compte" Width="560" Height="670" MinWidth="480" MinHeight="500" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource {x:Type Window}}">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
 <TextBlock x:Name="Heading" Text="Nouveau compte" Style="{StaticResource WindowHeading}" TextWrapping="Wrap"/>
 <TextBlock x:Name="ModeNotice" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,16"/>
 <Label Content="_Nom" Target="{Binding ElementName=AccountName}"/><TextBox x:Name="AccountName" MaxLength="120" AutomationProperties.AutomationId="NewAccountName" AutomationProperties.Name="Nom du compte"/>
 <Label Content="_Devise native (non modifiable après création)" Target="{Binding ElementName=NativeCurrency}"/><ComboBox x:Name="NativeCurrency" ItemsSource="{Binding CurrencyRegistry.Currencies}" DisplayMemberPath="Code" SelectedIndex="0" AutomationProperties.AutomationId="NewAccountCurrency" AutomationProperties.Name="Devise native du nouveau compte"/>
 <Label Content="_Type de compte" Target="{Binding ElementName=AccountType}"/><ComboBox x:Name="AccountType" IsEditable="True" Text="Courant" AutomationProperties.Name="Type de compte, suggestion ou saisie libre"><ComboBoxItem Content="Courant"/><ComboBoxItem Content="Épargne"/><ComboBoxItem Content="Espèces"/><ComboBoxItem Content="Autre"/></ComboBox>
 <Label Content="Solde _initial (dans la devise native)" Target="{Binding ElementName=OpeningBalance}"/><TextBox x:Name="OpeningBalance" Text="0,00" AutomationProperties.AutomationId="NewAccountOpeningBalance" AutomationProperties.Name="Solde initial signé dans la devise native"/>
 <StackPanel x:Name="BankFields">
     <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <StackPanel><Label Content="_Banque (facultatif)" Target="{Binding ElementName=BankName}"/>
             <TextBox x:Name="BankName" MaxLength="120" AutomationProperties.AutomationId="AccountBankName"/>
         </StackPanel>
         <StackPanel Grid.Column="2"><Label Content="T_itulaire (facultatif)" Target="{Binding ElementName=Holder}"/>
             <TextBox x:Name="Holder" MaxLength="120" AutomationProperties.AutomationId="AccountHolder"/>
         </StackPanel>
     </Grid>
     <Label Content="_Référence bancaire (facultatif)" Target="{Binding ElementName=BankReference}"/>
     <TextBox x:Name="BankReference" MaxLength="120" AutomationProperties.AutomationId="AccountBankReference"/>
 </StackPanel>
 <Label Content="Infos complémentaires et _notes" Target="{Binding ElementName=Notes}"/><TextBox x:Name="Notes" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap" Height="65" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Informations complémentaires du compte, facultatives"/>
 </StackPanel></ScrollViewer>
 <StackPanel Grid.Row="1" Margin="0,12,0,0">
     <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{DynamicResource NegativeBrush}" AutomationProperties.AutomationId="NewAccountError"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0"><Button Content="Annuler" IsCancel="True" MinWidth="90" Margin="0,0,8,0"/><Button x:Name="ConfirmAccount" Content="Ajouter au dossier" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Add_Click" AutomationProperties.AutomationId="ConfirmAccount"/></StackPanel>
 </StackPanel>
 </Grid>
</Window>
