<Window x:Class="Moneta.App.AccountWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Ajouter un compte" Width="560" Height="610" MinWidth="480" MinHeight="500" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource {x:Type Window}}">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
 <TextBlock x:Name="Heading" Text="Nouveau compte" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
 <TextBlock x:Name="ModeNotice" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,16"/>
 <Label Content="_Nom" Target="{Binding ElementName=AccountName}"/><TextBox x:Name="AccountName" MaxLength="120" AutomationProperties.AutomationId="NewAccountName" AutomationProperties.Name="Nom du compte"/>
 <Label Content="_Devise native (non modifiable après création)" Target="{Binding ElementName=NativeCurrency}"/><ComboBox x:Name="NativeCurrency" ItemsSource="{Binding CurrencyRegistry.Currencies}" DisplayMemberPath="Code" SelectedIndex="0" AutomationProperties.AutomationId="NewAccountCurrency" AutomationProperties.Name="Devise native du nouveau compte"/>
 <Label Content="_Type de compte" Target="{Binding ElementName=AccountType}"/><ComboBox x:Name="AccountType" IsEditable="True" Text="Courant" AutomationProperties.Name="Type de compte, suggestion ou saisie libre"><ComboBoxItem Content="Courant"/><ComboBoxItem Content="Épargne"/><ComboBoxItem Content="Espèces"/><ComboBoxItem Content="Autre"/></ComboBox>
 <Label Content="Solde _initial (dans la devise native)" Target="{Binding ElementName=OpeningBalance}"/><TextBox x:Name="OpeningBalance" Text="0,00" AutomationProperties.AutomationId="NewAccountOpeningBalance" AutomationProperties.Name="Solde initial signé dans la devise native"/>
 <Label Content="Informations complémentaires _facultatives" Target="{Binding ElementName=Notes}"/><TextBox x:Name="Notes" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap" Height="65" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Informations complémentaires du compte, facultatives"/>
 <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{DynamicResource NegativeBrush}" Margin="0,12,0,0" AutomationProperties.AutomationId="NewAccountError"/>
 </StackPanel></ScrollViewer>
 <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="Annuler" IsCancel="True" MinWidth="90" Margin="0,0,8,0"/><Button x:Name="ConfirmAccount" Content="Ajouter au dossier" IsDefault="True" Click="Add_Click" AutomationProperties.AutomationId="ConfirmAccount"/></StackPanel>
 </Grid>
</Window>
