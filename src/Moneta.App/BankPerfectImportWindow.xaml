<Window xmlns:loc="clr-namespace:Moneta.App" x:Class="Moneta.App.BankPerfectImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{loc:LocalizedText BankPerfectImportWindow.ImportABankperfectFile}" Width="760" Height="530"
        MinWidth="560" MinHeight="415" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource {x:Type Window}}" Language="{loc:LocalizedLanguage}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{loc:LocalizedText BankPerfectImportWindow.ImportABankperfectFile}" Style="{StaticResource WindowHeading}" Margin="0,0,0,12"/>
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="SourceText" Text="{loc:LocalizedText BankPerfectImportWindow.ChooseTheSourceFileToScan}" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" AutomationProperties.AutomationId="BankPerfectSource"/>
            <Button Grid.Column="1" x:Name="BrowseButton" Content="{loc:LocalizedText BankPerfectImportWindow.ChooseTheBpFileAccessKey}" Click="Browse_Click"
                    Margin="8,0,0,0" AutomationProperties.AutomationId="ChooseBankPerfectSource"/>
        </Grid>
        <TextBox Grid.Row="2" x:Name="ReportText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="{loc:LocalizedText BankPerfectImportWindow.BankperfectReport}" AutomationProperties.AutomationId="BankPerfectReport"/>
        <TextBlock Grid.Row="3" x:Name="StatusText" TextWrapping="Wrap" Margin="0,12,0,8"
                   Foreground="{DynamicResource MutedBrush}" AutomationProperties.LiveSetting="Polite"
                   AutomationProperties.AutomationId="BankPerfectImportStatus"/>
        <DockPanel Grid.Row="4" LastChildFill="False">
            <Button DockPanel.Dock="Right" x:Name="CloseButton" Content="Fermer" Click="Close_Click" MinWidth="86"
                    AutomationProperties.AutomationId="CloseBankPerfectImport"/>
            <Button DockPanel.Dock="Right" x:Name="ImportButton" Visibility="Collapsed" Content="{loc:LocalizedText BankPerfectImportWindow.CreateDocumentAccessKey}"
                    Click="Import_Click" Margin="0,0,8,0" AutomationProperties.AutomationId="ConfirmBankPerfectImport"/>
            <Button DockPanel.Dock="Right" x:Name="OpenButton" Visibility="Collapsed" Content="{loc:LocalizedText BankPerfectImportWindow.OpenImportedDocumentAccessKey}"
                    Click="Open_Click" Margin="0,0,8,0" AutomationProperties.AutomationId="OpenBankPerfectResult"/>
        </DockPanel>
    </Grid>
</Window>
