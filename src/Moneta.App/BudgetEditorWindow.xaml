<Window x:Class="Moneta.App.BudgetEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Budget mensuel — Moneta"
        Width="650" Height="590" MinWidth="500" MinHeight="420" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Style="{StaticResource {x:Type Window}}" AutomationProperties.AutomationId="BudgetEditor">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="Heading" FontSize="22" FontWeight="SemiBold" />
            <Label Content="_Nom" Target="{Binding ElementName=NameInput}" />
            <TextBox x:Name="NameInput" MaxLength="120" AutomationProperties.Name="Nom du budget" />
            <WrapPanel Margin="0,4,0,12">
                <StackPanel Margin="0,0,12,0"><Label Content="_Mois (mm/aaaa)" Target="{Binding ElementName=MonthInput}" /><TextBox x:Name="MonthInput" Width="116" MaxLength="7" AutomationProperties.Name="Mois du budget" /></StackPanel>
                <StackPanel Margin="0,0,12,0"><Label Content="_Devise" Target="{Binding ElementName=CurrencyInput}" /><ComboBox x:Name="CurrencyInput" Width="84" DisplayMemberPath="Code" AutomationProperties.Name="Devise du budget" /></StackPanel>
                <StackPanel><Label Content="_Montant prévu" Target="{Binding ElementName=AmountInput}" /><TextBox x:Name="AmountInput" Width="145" MaxLength="60" AutomationProperties.Name="Montant prévu" /></StackPanel>
            </WrapPanel>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Label Content="_Comptes" Target="{Binding ElementName=AccountsInput}" />
            <Label Grid.Column="1" Content="Ca_tégories et sous-catégories" Target="{Binding ElementName=CategoriesInput}" />
            <ListBox x:Name="AccountsInput" Grid.Row="1" Margin="0,0,8,0" SelectionMode="Multiple" DisplayMemberPath="Label" Style="{StaticResource FinancialScopeList}" AutomationProperties.Name="Comptes du budget" />
            <ListBox x:Name="CategoriesInput" Grid.Row="1" Grid.Column="1" SelectionMode="Multiple" DisplayMemberPath="Label" Style="{StaticResource FinancialScopeList}" AutomationProperties.Name="Catégories du budget" />
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite" />
            <WrapPanel HorizontalAlignment="Right"><Button Content="Annuler" IsCancel="True" Margin="0,0,8,0" /><Button Content="_Appliquer" IsDefault="True" Click="Apply_Click" /></WrapPanel>
        </StackPanel>
    </Grid>
</Window>
