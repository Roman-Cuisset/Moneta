<Window xmlns:loc="clr-namespace:Moneta.App" x:Class="Moneta.App.TransactionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{loc:LocalizedText Common.NewTransaction}" Width="680" Height="760" MinWidth="540" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource {x:Type Window}}"
        AutomationProperties.AutomationId="TransactionWindow" Language="{loc:LocalizedLanguage}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock x:Name="Heading" Text="{loc:LocalizedText Common.NewTransaction}" Style="{StaticResource WindowHeading}" />
            <TextBlock Text="{loc:LocalizedText TransactionWindow.DraftSaveCtrlSForSqliteWritingAfter}"
                       TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"
                       AutomationProperties.AutomationId="TransactionDraftNotice" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="160" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <Label Content="{loc:LocalizedText TransactionWindow.FixedAccount}" Target="{Binding ElementName=TransactionAccount}" />
                        <TextBox x:Name="TransactionAccount" IsReadOnly="True" IsTabStop="False"
                                 AutomationProperties.AutomationId="TransactionAccount" AutomationProperties.Name="{loc:LocalizedText TransactionWindow.TransactionAccountNonModifiable}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <Label Content="{loc:LocalizedText TransactionWindow.NationalCurrencyFixed}" Target="{Binding ElementName=NativeCurrency}" />
                        <TextBox x:Name="NativeCurrency" IsReadOnly="True" IsTabStop="False"
                                 AutomationProperties.AutomationId="NativeCurrency" AutomationProperties.Name="{loc:LocalizedText TransactionWindow.NativeCurrencyNonModifiable}" />
                    </StackPanel>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <Label Content="{loc:LocalizedText TransactionWindow.DateMmDdYyyyAccessKey}" Target="{Binding ElementName=EntryDate}" />
                        <TextBox x:Name="EntryDate" MaxLength="10" AutomationProperties.AutomationId="EntryDate"
                                 AutomationProperties.Name="{loc:LocalizedText TransactionWindow.DateOfTransactionInFormatDayMonthYear}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <Label Content="{loc:LocalizedText TransactionWindow.SenseAccessKey}" Target="{Binding ElementName=EntryDirection}" />
                        <ComboBox x:Name="EntryDirection" SelectedIndex="0" AutomationProperties.AutomationId="EntryDirection"
                                  AutomationProperties.Name="{loc:LocalizedText TransactionWindow.SenseOfTheTransaction}">
                            <ComboBoxItem Content="{loc:LocalizedText Common.Expense}" />
                            <ComboBoxItem Content="{loc:LocalizedText Common.Income2}" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Label Content="{loc:LocalizedText TransactionWindow.AmountWithoutSignAccessKey}" Target="{Binding ElementName=EntryAmount}" />
                        <TextBox x:Name="EntryAmount" MaxLength="128" TextAlignment="Right"
                                 AutomationProperties.AutomationId="EntryAmount" AutomationProperties.Name="{loc:LocalizedText TransactionWindow.PositiveOrNilAmountInTheNativeCurrency}" />
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="AmountHint" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,10" />
                <Label Content="{loc:LocalizedText TransactionWindow.WordingMandatoryAccessKey}" Target="{Binding ElementName=EntryLabel}" />
                <TextBox x:Name="EntryLabel" MaxLength="240" AutomationProperties.AutomationId="EntryLabel"
                         AutomationProperties.Name="{loc:LocalizedText TransactionWindow.DescriptionOfTheTransactionMandatory}" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <Label Content="{loc:LocalizedText TransactionWindow.PaymentMethodAccessKey}" Target="{Binding ElementName=EntryPaymentMode}" />
                        <ComboBox x:Name="EntryPaymentMode" IsEditable="True" IsTextSearchEnabled="False"
                                  AutomationProperties.AutomationId="EntryPaymentMode" AutomationProperties.Name="{loc:LocalizedText TransactionWindow.MethodOfPaymentSuggestionOrFreeEntry}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <Label Content="{loc:LocalizedText Common.PayeeAccessKey}" Target="{Binding ElementName=EntryPayee}" />
                        <ComboBox x:Name="EntryPayee" IsEditable="True" IsTextSearchEnabled="False"
                                  AutomationProperties.AutomationId="EntryPayee" AutomationProperties.Name="{loc:LocalizedText TransactionWindow.PayeeSuggestionOrFreeEntry}" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <Label Content="{loc:LocalizedText TransactionWindow.CategoryAccessKey}" Target="{Binding ElementName=EntryCategory}" />
                        <ComboBox x:Name="EntryCategory" IsEditable="True" IsTextSearchEnabled="False"
                                  AutomationProperties.AutomationId="EntryCategory" AutomationProperties.Name="{loc:LocalizedText TransactionWindow.RootCategorySuggestionOrFreeEntry}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <Label Content="{loc:LocalizedText TransactionWindow.SOurCategoryAccessKey}" Target="{Binding ElementName=EntrySubcategory}" />
                        <ComboBox x:Name="EntrySubcategory" IsEditable="True" IsTextSearchEnabled="False"
                                  AutomationProperties.AutomationId="EntrySubcategory" AutomationProperties.Name="{loc:LocalizedText TransactionWindow.SubcategoryOfChosenCategorySuggestionOrFreeEntry}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="{loc:LocalizedText TransactionWindow.OptionalFieldsChooseASuggestionOrEnterA}"
                           TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,8" />
                <Label Content="{loc:LocalizedText Common.NotesOptionalAccessKey}" Target="{Binding ElementName=EntryNotes}" />
                <TextBox x:Name="EntryNotes" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap"
                         Height="84" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                         AutomationProperties.AutomationId="EntryNotes" AutomationProperties.Name="{loc:LocalizedText TransactionWindow.TransactionNotesOptional}" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{DynamicResource NegativeBrush}"
                       AutomationProperties.AutomationId="TransactionError" AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
                       AutomationProperties.LiveSetting="Assertive" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="CancelTransaction" Content="{loc:LocalizedText Common.Cancel}" IsCancel="True" MinWidth="90" Margin="0,0,8,0"
                        AutomationProperties.AutomationId="CancelTransaction" />
                <Button x:Name="ConfirmTransaction" Content="{loc:LocalizedText Common.ValidateDraft}" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Confirm_Click"
                        AutomationProperties.AutomationId="ConfirmTransaction" AutomationProperties.Name="{loc:LocalizedText TransactionWindow.ValidateDraftWithoutRecordingToDisc}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
